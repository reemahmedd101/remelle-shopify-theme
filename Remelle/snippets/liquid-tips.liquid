{% doc %}
  Renders one Liquid tip from the hello-world translations.

  @example
  {% render 'liquid-tips' %}
{% enddoc %}

{%- liquid
  assign tips = 'hello_world.liquid_tips_1,hello_world.liquid_tips_2,hello_world.liquid_tips_3' | split: ','
  assign tip_count = tips.size
  assign seed = 'now' | date: '%N'
-%}

<div class="highlight">
  <h3>{{ 'hello_world.liquid_tips_title' | t }}</h3>

  {%- if tip_count > 0 -%}
    {%- assign index = seed | modulo: tip_count -%}
    {%- for tip in tips limit: 1 offset: index -%}
      <p class="highlight-description">{{ tip | t }}</p>
    {%- endfor -%}
  {%- endif -%}
</div>
