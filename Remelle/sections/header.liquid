{% liquid
  assign about_url = pages['about'].url | default: '/pages/about'
  assign account_menu = section.settings.customer_account_menu.handle | default: 'customer-account-main-menu'
  assign shop_url = routes.all_products_collection_url

  assign shop_label = section.settings.shop_label
  if shop_label == blank
    assign shop_label = 'chrome.shop' | t
  endif
  assign about_label = section.settings.about_label
  if about_label == blank
    assign about_label = 'chrome.about' | t
  endif
  assign account_label = section.settings.account_label
  if account_label == blank
    assign account_label = 'chrome.account' | t
  endif
  assign cart_base_label = section.settings.cart_label
  if cart_base_label == blank
    assign cart_base_label = 'chrome.cart' | t
  endif
%}

<header class="site-header" data-site-header>
  <nav class="site-header__bar" aria-label="{{ 'chrome.primary' | t }}">
    <div class="site-header__group site-header__group--start">
      <button
        class="site-header__menu-btn"
        type="button"
        data-nav-open
        aria-expanded="false"
        aria-controls="SiteHeaderMenu-{{ section.id }}"
        aria-label="{{ 'chrome.open_menu' | t }}"
      >
        <span class="site-header__menu-icon" aria-hidden="true"></span>
      </button>

      <div class="site-header__desktop-links">
        {% capture primary_titles %}{{ shop_label }}|{{ about_label }}{% endcapture %}
        {% capture primary_urls %}{{ shop_url }}|{{ about_url }}{% endcapture %}
        {% render 'menu-links', menu: section.settings.menu, titles: primary_titles, urls: primary_urls, class: 'site-nav-link' %}
      </div>
    </div>

    <a class="site-header__wordmark" href="{{ routes.root_url }}" aria-label="{{ 'chrome.wordmark' | t }}">
      {% render 'wordmark', variant: 'nav' %}
    </a>

    <div class="site-header__group site-header__group--end">
      {% if shop.customer_accounts_enabled %}
        <shopify-account
          class="site-header__account"
          menu="{{ account_menu }}"
          data-sign-out-url="{{ routes.account_logout_url }}"
          data-sign-out-label="{{ 'chrome.sign_out' | t | escape }}"
        >
          <span slot="signed-out-avatar" class="site-header__account-icon">
            {{ 'icon-account.svg' | inline_asset_content }}
            <span class="site-header__account-label">{{ account_label | escape }}</span>
          </span>
        </shopify-account>
      {% endif %}
      <a
        class="site-nav-link site-header__cart"
        href="{{ routes.cart_url }}"
        data-cart-link
        data-cart-label="{{ cart_base_label | escape }}"
      >
        <span data-cart-text>{{ cart_base_label | escape }} (<span data-cart-count>{{ cart.item_count }}</span>)</span>
      </a>
    </div>
  </nav>

  <div
    class="site-header__drawer"
    id="SiteHeaderMenu-{{ section.id }}"
    data-nav-drawer
    hidden
  >
    <div class="site-header__drawer-panel" role="dialog" aria-modal="true" aria-label="{{ 'chrome.primary' | t }}">
      <div class="site-header__drawer-top">
        <button
          class="site-header__close"
          type="button"
          data-nav-close
          aria-label="{{ 'chrome.close_menu' | t }}"
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <ul class="site-header__drawer-links">
        <li><a class="site-header__drawer-link" href="{{ shop_url }}">{{ shop_label | escape }}</a></li>
        <li><a class="site-header__drawer-link" href="{{ about_url }}">{{ about_label | escape }}</a></li>
        <li>
          <a
            class="site-header__drawer-link"
            href="{{ routes.cart_url }}"
            data-cart-link
            data-cart-label="{{ cart_base_label | escape }}"
          >
            <span data-cart-text>{{ cart_base_label | escape }} (<span data-cart-count>{{ cart.item_count }}</span>)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

{% javascript %}
  document.querySelectorAll('[data-site-header]').forEach((header) => {
    const openBtn = header.querySelector('[data-nav-open]');
    const closeBtn = header.querySelector('[data-nav-close]');
    const drawer = header.querySelector('[data-nav-drawer]');
    if (!openBtn || !drawer) return;

    let closeTimer = 0;
    const setOpen = (open) => {
      window.clearTimeout(closeTimer);
      openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.documentElement.classList.toggle('nav-open', open);
      if (open) {
        drawer.hidden = false;
        requestAnimationFrame(() => drawer.classList.add('is-open'));
        return;
      }
      drawer.classList.remove('is-open');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) {
        drawer.hidden = true;
        return;
      }
      closeTimer = window.setTimeout(() => {
        drawer.hidden = true;
      }, 380);
    };

    openBtn.addEventListener('click', () => setOpen(true));
    if (closeBtn) closeBtn.addEventListener('click', () => setOpen(false));
    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) setOpen(false);
    });
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !drawer.hidden) setOpen(false);
    });
  });

  const watchAccount = (account, tries = 0) => {
    if (!account.shadowRoot) {
      if (tries < 40) requestAnimationFrame(() => watchAccount(account, tries + 1));
      return;
    }
    if (account.dataset.remelleAccountBound === 'true') return;
    account.dataset.remelleAccountBound = 'true';

    const signOutUrl = account.dataset.signOutUrl;
    const signOutLabel = account.dataset.signOutLabel;
    const syncAccount = () => {
      const root = account.shadowRoot;
      const login = root.querySelector('.account__login-slot');
      const menu = root.querySelector('.account__menu-region');
      const sheet = root.querySelector('.account');
      if (!login || !menu || !sheet) return;

      const signedIn = login.hasAttribute('hidden') && !sheet.classList.contains('loading');
      menu.style.display = signedIn ? '' : 'none';
      if (!signedIn) return;

      const nav = menu.querySelector('nav');
      if (!nav) return;
      nav.querySelectorAll('a').forEach((link) => {
        if (link.dataset.remelleSignOut === 'true') return;
        const href = link.getAttribute('href') || '';
        const keep = href.includes('/orders') || href.includes('/profile');
        if (!keep) link.remove();
      });
      if (!signOutUrl || nav.querySelector('[data-remelle-sign-out]')) return;

      const signOut = document.createElement('a');
      signOut.className = 'button outline';
      signOut.href = signOutUrl;
      signOut.target = '_top';
      signOut.dataset.remelleSignOut = 'true';
      signOut.textContent = signOutLabel;
      nav.appendChild(signOut);
    };

    new MutationObserver(syncAccount).observe(account.shadowRoot, {
      subtree: true,
      childList: true,
      attributes: true,
      attributeFilter: ['hidden', 'class']
    });
    syncAccount();
  };

  document.querySelectorAll('shopify-account[data-sign-out-url]').forEach((account) => {
    watchAccount(account);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "t:labels.shop_label",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "about_label",
      "label": "t:labels.about_label",
      "default": "About"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "t:labels.account_label",
      "default": "Account"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "t:labels.cart_label",
      "default": "Cart",
      "info": "t:labels.cart_label_info"
    }
  ],
  "presets": [
    {
      "name": "t:general.header"
    }
  ]
}
{% endschema %}
