{% doc %}
  Shared styles for the announcement bar, navigation, and footer.

  @example
  {% render 'chrome-styles' %}
{% enddoc %}

{% stylesheet %}
  main {
    flex: 1 0 auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-to-content:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    width: auto;
    height: auto;
    margin: 0;
    padding: 12px 16px;
    overflow: visible;
    clip: auto;
    background: var(--color-burgundy);
    color: var(--color-off-white);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: normal;
  }

  .announcement {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--header-announcement-height);
    background: var(--color-burgundy);
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    line-height: 12px;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
  }

  .site-header {
    background: var(--color-beige);
    color: var(--color-burgundy);
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-nav-height);
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .site-header__group {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .site-header__group--end {
    justify-content: flex-end;
  }

  .site-nav-link {
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .wordmark {
    display: block;
    object-fit: contain;
  }

  .wordmark--nav {
    width: 128px;
    height: 24px;
  }

  .wordmark--footer {
    width: 469px;
    height: auto;
    margin-inline: auto;
  }

  .site-header a:focus-visible,
  .site-footer a:focus-visible,
  .site-footer button:focus-visible,
  .site-footer input:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 2px;
  }

  .site-footer {
    background: var(--color-burgundy);
    color: var(--color-beige);
    padding-top: 80px;
    padding-bottom: 48px;
  }

  .site-footer__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .site-footer__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 88px;
  }

  .site-footer__columns {
    display: flex;
    flex: none;
    gap: 88px;
  }

  .site-footer__title {
    margin-bottom: 16px;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    line-height: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__link,
  .site-footer__social {
    display: inline-flex;
    align-items: center;
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .site-footer__social {
    gap: 2px;
  }

  .site-footer__rule-wrap {
    padding-top: 32px;
  }

  .site-footer__rule {
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-beige) 30%, transparent);
  }

  .site-footer__brand {
    padding-top: 48px;
    text-align: center;
  }

  .site-footer__copyright {
    margin-top: 32px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    color: color-mix(in srgb, var(--color-beige) 60%, transparent);
  }

  .newsletter {
    width: 305px;
    flex: none;
  }

  .newsletter .site-footer__title {
    margin-bottom: 8px;
  }

  .newsletter__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .newsletter__row input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-none);
    background: transparent;
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
  }

  .newsletter__row input::placeholder {
    color: color-mix(in srgb, var(--color-beige) 60%, transparent);
    opacity: 1;
  }

  .newsletter__send {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-off-white);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    line-height: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .newsletter__rule {
    display: block;
    margin-top: 12px;
    border-top: 1px solid var(--color-beige);
  }

  .newsletter__errors {
    margin-top: 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
  }

  .icon-arrow-up-right {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .site-header__menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-burgundy);
    cursor: pointer;
  }

  .site-header__menu-icon,
  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    display: block;
    width: 18px;
    height: 1px;
    background: currentColor;
  }

  .site-header__menu-icon {
    position: relative;
  }

  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .site-header__menu-icon::before {
    top: -6px;
  }

  .site-header__menu-icon::after {
    top: 6px;
  }

  .site-header__desktop-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .site-header__drawer {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(6, 5, 5, 0.28);
  }

  .site-header__drawer[hidden] {
    display: none;
  }

  .site-header__drawer-panel {
    width: min(100%, 360px);
    height: 100%;
    padding: 24px var(--page-inset);
    background: var(--color-beige);
    color: var(--color-burgundy);
    overflow: auto;
  }

  .site-header__drawer-top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 32px;
  }

  .site-header__close {
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: var(--color-burgundy);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }

  .site-header__drawer-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__drawer-link {
    display: block;
    padding: 16px 0;
    border-bottom: 1px solid rgba(103, 13, 13, 0.16);
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1.44px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: center;
    margin-top: 24px;
  }

  .site-footer__policy {
    color: color-mix(in srgb, var(--color-beige) 80%, transparent);
    font-family: var(--font-sans);
    font-size: 12px;
    text-decoration: underline;
  }

  .site-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 24px;
  }

  .newsletter__success {
    margin-top: 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.3;
  }

  html.nav-open,
  html.nav-open body {
    overflow: hidden;
  }

  @media (max-width: 1024px) {
    .site-footer__top {
      flex-direction: column;
      gap: 48px;
    }

    .site-footer__columns {
      flex-wrap: wrap;
      gap: 40px 48px;
    }

    .newsletter {
      width: min(305px, 100%);
    }
  }

  @media (max-width: 768px) {
    .site-header__menu-btn {
      display: inline-flex;
    }

    .site-header__desktop-links {
      display: none;
    }

    .site-header__bar {
      grid-template-columns: 40px 1fr auto;
      gap: 12px;
    }

    .site-header__group--start {
      justify-content: flex-start;
    }

    .site-header__wordmark {
      justify-self: center;
    }

    .wordmark--nav {
      width: 110px;
      height: 20px;
    }

    .wordmark--footer {
      width: min(469px, 100%);
    }

    .site-footer {
      padding-top: 56px;
      padding-bottom: 40px;
    }

    .site-footer__columns {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 24px;
      width: 100%;
    }

    .site-footer__title,
    .site-footer__link,
    .site-footer__social {
      white-space: normal;
    }
  }

  @media (max-width: 414px) {
    .site-footer__columns {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}
