<section class="remelle-about-story" aria-labelledby="RemelleAboutStory-{{ section.id }}">
  <div class="remelle-about-story__inner">
    <div class="remelle-about-story__media">
      {%- if section.settings.image != blank -%}
        {%- assign story_alt = section.settings.image_alt | default: section.settings.image.alt -%}
        {{
          section.settings.image
          | image_url: width: 1400, format: 'jpg' | image_tag:
            widths: '624, 900, 1248, 1400',
            sizes: '624px',
            alt: story_alt,
            class: 'remelle-about-story__image',
            loading: 'eager'
        }}
      {%- else -%}
        <img
          class="remelle-about-story__image"
          src="{{ 'Story image frame.png' | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="624"
          height="570"
          loading="eager"
        >
      {%- endif -%}
    </div>

    <div class="remelle-about-story__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="remelle-about-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="remelle-about-story__heading" id="RemelleAboutStory-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h1>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="remelle-about-story__body">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .remelle-about-story {
    padding-block: 64px;
  }

  .remelle-about-story__inner {
    display: flex;
    align-items: center;
    gap: 88px;
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .remelle-about-story__media {
    flex: 0 0 624px;
    width: 624px;
    height: 570px;
    background: var(--color-beige);
    overflow: hidden;
  }

  .remelle-about-story__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .remelle-about-story__copy {
    flex: 1 1 632px;
    max-width: 632px;
  }

  .remelle-about-story__eyebrow {
    margin: 0 0 20px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 15px;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-about-story__heading {
    max-width: 530px;
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .remelle-about-story__body {
    max-width: 530px;
    margin-top: 32px;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 22px;
  }

  .remelle-about-story__body p {
    margin: 0;
  }

  .remelle-about-story__body p + p {
    margin-top: 22px;
  }

  @media (max-width: 1024px) {
    .remelle-about-story__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }

    .remelle-about-story__media,
    .remelle-about-story__copy {
      flex: none;
      width: 100%;
      max-width: none;
    }

    .remelle-about-story__media {
      height: auto;
      aspect-ratio: 624 / 570;
    }

    .remelle-about-story__heading,
    .remelle-about-story__body {
      max-width: none;
    }
  }

  @media (max-width: 768px) {
    .remelle-about-story {
      padding-block: 48px;
    }

    .remelle-about-story__heading {
      font-size: 40px;
      line-height: 1.05;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_story",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.editorial_image",
      "info": "t:labels.about_image_info"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.editorial_image_alt",
      "default": "Close-up of a burgundy coat with the Remelle mark"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "About Remelle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "More than a collection. A point of view."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.description",
      "default": "<p>Remelle started with something simple: a love for getting dressed.</p><p>Before it was a brand, it was an instinct — putting pieces together, playing with silhouettes, textures and details, and finding a way to make every look feel like me.</p><p>I started sharing my outfits and styling on TikTok, simply because fashion has always been a part of how I express myself. The response made me realize that what I was creating went beyond individual outfits. People connected with the way I saw fashion.</p><p>And that became the beginning of Remelle.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:general.about_story"
    }
  ]
}
{% endschema %}
