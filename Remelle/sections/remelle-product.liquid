{%- liquid
  assign current = product.selected_or_first_available_variant
  assign basket_label = section.settings.add_label
  if basket_label == blank
    assign basket_label = 'product.add_to_basket' | t
  endif
  assign preorder_label = section.settings.preorder_button_label
  if preorder_label == blank
    assign preorder_label = 'product.preorder_now' | t
  endif
  assign preorder_note = section.settings.preorder_note
  if preorder_note == blank
    assign preorder_note = 'product.preorder_note' | t
  endif
  assign delivery_note = section.settings.delivery_note
  if delivery_note == blank
    assign delivery_note = 'product.delivery_note' | t
  endif
  assign preorder_button = false
  assign preorder_list = section.settings.preorder_products
  if preorder_list == blank
    assign preorder_list = settings.preorder_products
  endif
  assign preorder_on = false
  if section.settings.show_preorder_badge == true or settings.show_preorder_badge == true or preorder_list != blank
    assign preorder_on = true
  endif
  if preorder_on
    if preorder_list != blank
      for preorder_item in preorder_list
        if preorder_item.id == product.id or preorder_item.handle == product.handle
          assign preorder_button = true
        endif
      endfor
    else
      assign preorder_tag = section.settings.preorder_tag | default: settings.preorder_tag | downcase | strip
      if preorder_tag != blank
        for tag in product.tags
          assign tag_value = tag | downcase | strip
          if tag_value == preorder_tag or tag_value == 'pre order' or tag_value == 'preorder' or tag_value == 'pre-order'
            assign preorder_button = true
          endif
        endfor
      endif
    endif
  endif
  assign product_form_id = 'RemelleProductForm-' | append: section.id
-%}

{%- capture current_preorder_flag -%}
  {%- render 'remelle-variant-preorder',
    product: product,
    variant: current,
    preorder_product: preorder_button,
    rules: section.settings.preorder_size_rules
  -%}
{%- endcapture -%}
{%- liquid
  assign current_is_preorder = false
  assign current_preorder_flag = current_preorder_flag | strip
  if current_preorder_flag == 'true'
    assign current_is_preorder = true
  endif
  assign add_label = basket_label
  if current_is_preorder
    assign add_label = preorder_label
  endif
-%}

<section class="remelle-pdp" aria-labelledby="RemelleProductTitle-{{ section.id }}">
  <div class="remelle-pdp__layout">
    <div class="remelle-pdp__gallery{% if product.images.size < 2 %} remelle-pdp__gallery--single{% endif %}">
      <div class="remelle-pdp__stage">
        <div
          class="remelle-pdp__slides"
          data-gallery-track
          aria-label="{{ 'product.gallery' | t }}"
          {% if product.images.size > 1 %}tabindex="0"{% endif %}
        >
          {%- if product.images.size > 0 -%}
            {%- for gallery_image in product.images -%}
              {%- liquid
                assign image_loading = 'lazy'
                assign image_alt = gallery_image.alt | default: product.title
                if forloop.first
                  assign image_loading = 'eager'
                endif
              -%}
              <div
                class="remelle-pdp__slide{% if forloop.first %} is-active{% endif %}"
                data-gallery-slide
                data-image-id="{{ gallery_image.id }}"
                {% unless forloop.first %}aria-hidden="true"{% endunless %}
              >
                {{
                  gallery_image
                  | image_url: width: 1600, format: 'jpg' | image_tag:
                    widths: '400, 800, 1200, 1600',
                    sizes: '(min-width: 1024px) 640px, 100vw',
                    alt: image_alt,
                    class: 'remelle-pdp__image',
                    loading: image_loading
                }}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="remelle-pdp__slide is-active"></div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <button class="remelle-pdp__nav remelle-pdp__nav--prev" type="button" data-gallery-prev aria-label="{{ 'product.previous_image' | t }}">
            {% render 'icon-arrow-left' %}
          </button>
          <button class="remelle-pdp__nav remelle-pdp__nav--next" type="button" data-gallery-next aria-label="{{ 'product.next_image' | t }}">
            {% render 'icon-arrow-right' %}
          </button>
        {%- endif -%}
        {% render 'remelle-product-badges',
          product: product,
          variant: 'pdp',
          show_new_badge: section.settings.show_new_badge,
          badge_label: section.settings.badge_label,
          badge_tag: section.settings.badge_tag,
          new_products: section.settings.new_products,
          show_sale_badge: section.settings.show_sale_badge,
          sale_label: section.settings.sale_label,
          sale_tag: section.settings.sale_tag,
          sale_products: section.settings.sale_products,
          show_limited_badge: section.settings.show_limited_badge,
          limited_label: section.settings.limited_label,
          limited_tag: section.settings.limited_tag,
          limited_products: section.settings.limited_products,
          show_preorder_badge: section.settings.show_preorder_badge,
          preorder_label: section.settings.preorder_label,
          preorder_tag: section.settings.preorder_tag,
          preorder_products: section.settings.preorder_products,
          preorder_placement: 'details',
          show_coming_soon_badge: section.settings.show_coming_soon_badge,
          coming_soon_label: section.settings.coming_soon_label,
          coming_soon_tag: section.settings.coming_soon_tag,
          coming_soon_products: section.settings.coming_soon_products,
          show_low_stock_badge: section.settings.show_low_stock_badge,
          low_stock_label: section.settings.low_stock_label,
          low_stock_threshold: section.settings.low_stock_threshold,
          low_stock_products: section.settings.low_stock_products
        %}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="remelle-pdp__thumbs" data-gallery-thumbs aria-label="{{ 'product.gallery' | t }}">
          {%- for gallery_image in product.images -%}
            <button
              class="remelle-pdp__thumb{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-gallery-thumb
              data-image-id="{{ gallery_image.id }}"
              aria-label="{{ 'product.thumbnail' | t: number: forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            >
              {{
                gallery_image
                | image_url: width: 160, format: 'jpg' | image_tag:
                  widths: '80, 160',
                  sizes: '64px',
                  alt: '',
                  loading: 'lazy'
              }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="remelle-pdp__buy">
      <div class="remelle-pdp__heading">
        <h1 class="remelle-pdp__title" id="RemelleProductTitle-{{ section.id }}">{{ product.title | escape }}</h1>
        <div class="remelle-pdp__price-row">
          {%- if current.compare_at_price > current.price -%}
            <s class="remelle-pdp__compare" data-product-compare>{{ current.compare_at_price | money }}</s>
          {%- else -%}
            <s class="remelle-pdp__compare remelle-pdp__compare--hidden" data-product-compare hidden></s>
          {%- endif -%}
          <p class="remelle-pdp__price" data-product-price>{{ current.price | money }}</p>
        </div>
        {% render 'remelle-product-badges',
          product: product,
          variant: 'preorder',
          show_preorder_badge: section.settings.show_preorder_badge,
          preorder_label: section.settings.preorder_label,
          preorder_tag: section.settings.preorder_tag,
          preorder_products: section.settings.preorder_products
        %}
      </div>

      {%- if product.description != blank -%}
        <div class="remelle-pdp__description">{{ product.description }}</div>
      {%- endif -%}

      {% form 'product', product, class: 'remelle-pdp__form', id: product_form_id %}
        {%- if form.errors -%}
          <div class="remelle-pdp__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <p class="remelle-pdp__unavailable" data-unavailable hidden>
          {{ 'product.unavailable' | t }}
        </p>
        <p class="remelle-pdp__errors" data-cart-error hidden role="alert"></p>
        <p class="remelle-pdp__status" data-cart-status hidden role="status"></p>

        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- assign option_passes = 'color,size,other' | split: ',' -%}
          {%- for pass in option_passes -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_name = option.name | downcase
              assign is_color = false
              assign is_size = false
              if option_name == 'color' or option_name == 'colour'
                assign is_color = true
              endif
              if option_name == 'size'
                assign is_size = true
              endif
              assign show_option = false
              if pass == 'color' and is_color
                assign show_option = true
              elsif pass == 'size' and is_size
                assign show_option = true
              elsif pass == 'other' and is_color == false and is_size == false
                assign show_option = true
              endif
            -%}
            {%- if show_option -%}
            <fieldset class="remelle-pdp__option{% if is_color %} remelle-pdp__option--color{% elsif is_size %} remelle-pdp__option--size{% endif %}">
              <legend class="remelle-pdp__legend">
                <span>{{ option.name | escape }}</span>
                {%- if is_color -%}
                  <span class="remelle-pdp__legend-value" data-color-current>{{ option.selected_value | escape }}</span>
                {%- endif -%}
              </legend>
              <div class="remelle-pdp__choices">
                {%- for value in option.values -%}
                  {%- liquid
                    assign swatch_color = value.swatch.color
                    if swatch_color == blank and is_color
                      assign swatch_name = value.name | downcase
                      case swatch_name
                        when 'burgundy', 'dark red'
                          assign swatch_color = '#670D0D'
                        when 'black'
                          assign swatch_color = '#060505'
                        when 'off white', 'cream', 'ivory', 'white', 'cream white'
                          assign swatch_color = '#F5EDE3'
                        when 'beige', 'light beige'
                          assign swatch_color = '#F5EDE3'
                        when 'brown', 'choco brown'
                          assign swatch_color = '#6A4A38'
                        else
                          assign swatch_color = '#D0CBC4'
                      endcase
                    endif
                    assign choice_label = value.name | replace: '/', ' / '
                  -%}
                  <label class="remelle-pdp__choice{% if is_color %} remelle-pdp__choice--color{% else %} remelle-pdp__choice--text{% endif %}">
                    <input
                      type="radio"
                      name="option-{{ option.position }}"
                      value="{{ value.name | escape }}"
                      {% if value.selected %}checked{% endif %}
                      data-option
                    >
                    {%- if is_color -%}
                      <span
                        class="remelle-pdp__swatch"
                        style="{% if swatch_color != blank %}background: {{ swatch_color }};{% endif %}"
                      ></span>
                      <span class="remelle-pdp__choice-label">{{ value.name | escape }}</span>
                    {%- else -%}
                      <span class="remelle-pdp__choice-name">{{ choice_label | escape }}</span>
                    {%- endif -%}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
            {%- endif -%}
          {%- endfor -%}
          {%- endfor -%}
        {%- endunless -%}

        <div class="remelle-pdp__quantity">
          <p class="remelle-pdp__legend" id="RemelleProductQty-{{ section.id }}">{{ 'product.quantity' | t }}</p>
          <div class="remelle-pdp__qty">
            <button class="remelle-pdp__qty-btn remelle-pdp__qty-btn--minus" type="button" data-qty="-1" aria-label="{{ 'product.decrease' | t }}">
              {% render 'icon-minus' %}
            </button>
            <input
              class="remelle-pdp__qty-input"
              type="number"
              name="quantity"
              value="1"
              min="1"
              inputmode="numeric"
              data-qty-input
              aria-labelledby="RemelleProductQty-{{ section.id }}"
              {% if current.inventory_management != blank and current.inventory_policy == 'deny' and current.inventory_quantity > 0 %}
                max="{{ current.inventory_quantity }}"
              {% endif %}
            >
            <button class="remelle-pdp__qty-btn remelle-pdp__qty-btn--plus" type="button" data-qty="1" aria-label="{{ 'product.increase' | t }}">
              {% render 'icon-plus' %}
            </button>
          </div>
        </div>

        <div class="remelle-pdp__purchase">
          <button
            class="remelle-pdp__add"
            type="submit"
            name="add"
            data-add
            data-label="{{ add_label | escape }}"
            data-basket-label="{{ basket_label | escape }}"
            data-preorder-label="{{ preorder_label | escape }}"
            data-adding-label="{{ 'product.adding' | t | escape }}"
            data-added-label="{{ 'product.added' | t | escape }}"
            data-sold-out="{{ 'product.sold_out' | t | escape }}"
            data-unavailable-label="{{ 'product.unavailable' | t | escape }}"
            {% unless current.available %}disabled{% endunless %}
          >
            {%- if current.available -%}
              {{ add_label | escape }}
            {%- else -%}
              {{ 'product.sold_out' | t }}
            {%- endif -%}
          </button>
          {%- if preorder_note != blank -%}
            <p class="remelle-pdp__shipping-note remelle-pdp__preorder-note" data-preorder-note {% unless current_is_preorder %}hidden{% endunless %}>{{ preorder_note | escape }}</p>
          {%- endif -%}
          {%- if delivery_note != blank -%}
            <p
              class="remelle-pdp__shipping-note remelle-pdp__delivery-note"
              data-delivery-note
              {% unless current.available and current_is_preorder == false %}hidden{% endunless %}
            >{{ delivery_note | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_dynamic_checkout -%}
          <div class="remelle-pdp__dynamic" data-dynamic-checkout>
            {{ form | payment_button }}
          </div>
        {%- endif -%}
      {% endform %}

      {%- if section.blocks.size > 0 -%}
        <div class="remelle-pdp__info">
          {%- for block in section.blocks -%}
            {%- if block.settings.title != blank -%}
              <details class="remelle-pdp__row" {{ block.shopify_attributes }}>
                <summary>
                  <span class="remelle-pdp__expand" aria-hidden="true"></span>
                  <span>{{ block.settings.title | escape }}</span>
                </summary>
                {%- liquid
                  assign answer = block.settings.content
                  if block.settings.use_product_description and product.description != blank
                    assign answer = product.description
                  endif
                -%}
                {%- if answer != blank -%}
                  <div class="remelle-pdp__answer">{{ answer }}</div>
                {%- endif -%}
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-product-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "preorder": {% render 'remelle-variant-preorder', product: product, variant: variant, preorder_product: preorder_button, rules: section.settings.preorder_size_rules %},
          "price": {{ variant.price | money | json }},
          "compare_at_price": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "inventory_management": {{ variant.inventory_management | json }},
          "inventory_policy": {{ variant.inventory_policy | json }},
          "inventory_quantity": {{ variant.inventory_quantity | json }},
          "image_id": {% if variant.featured_image %}{{ variant.featured_image.id }}{% else %}null{% endif %}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>
</section>

{% stylesheet %}
  .remelle-pdp {
    padding-top: 48px;
  }

  .remelle-pdp__layout {
    display: flex;
    align-items: flex-start;
    gap: 48px;
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .remelle-pdp__gallery {
    --pdp-gallery-space: 96px;
    display: flex;
    flex: 1.15 1 560px;
    flex-direction: column;
    gap: 12px;
    width: min(560px, 100%);
    max-width: 560px;
    height: calc(100svh - var(--header-height) - var(--pdp-gallery-space));
    min-width: 0;
    min-height: 0;
  }

  .remelle-pdp__stage {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    background: var(--color-beige);
  }

  .remelle-pdp__slides {
    position: relative;
    height: 100%;
    background: var(--color-beige);
    touch-action: pan-y;
  }

  .remelle-pdp__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease;
  }

  .remelle-pdp__slide.is-active {
    z-index: 1;
    opacity: 1;
  }

  .remelle-pdp__slide img,
  .remelle-pdp__image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .remelle-pdp__thumbs {
    display: flex;
    flex: 0 0 auto;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .remelle-pdp__thumbs::-webkit-scrollbar {
    display: none;
  }

  .remelle-pdp__thumb {
    flex: 0 0 64px;
    width: 64px;
    height: 72px;
    padding: 4px;
    border: 1px solid transparent;
    background: var(--color-beige);
    cursor: pointer;
  }

  .remelle-pdp__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .remelle-pdp__thumb.is-active {
    border-color: var(--color-burgundy);
  }

  .remelle-pdp__thumb:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .remelle-pdp__slide,
    .remelle-pdp__dynamic .shopify-payment-button__button--unbranded {
      transition: none;
    }
  }

  .remelle-pdp__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--color-off-white) 88%, transparent);
    color: var(--color-burgundy);
    cursor: pointer;
    transform: translateY(-50%);
  }

  .remelle-pdp__nav--prev {
    left: 12px;
  }

  .remelle-pdp__nav--next {
    right: 12px;
  }

  .remelle-pdp__nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .remelle-pdp__nav:focus-visible,
  .remelle-pdp__slides:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  .remelle-pdp__badges {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    pointer-events: none;
  }

  .remelle-pdp__badge {
    margin: 0;
    padding: 2px 6px;
    border-radius: var(--radius-badge);
    background: #ffffff;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    line-height: 12px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .remelle-pdp__badge--limited,
  .remelle-pdp__badge--preorder,
  .remelle-pdp__badge--coming {
    color: #670d0d;
  }

  .remelle-pdp__preorder {
    margin: 14px 0 0;
    color: #670d0d;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .remelle-pdp__badge--sale {
    background: var(--color-burgundy);
    color: var(--color-off-white);
  }

  .remelle-pdp__stock {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 3;
    margin: 0;
    max-width: calc(100% - 24px);
    padding: 2px 6px;
    border-radius: var(--radius-badge);
    background: #ffffff;
    color: #670d0d;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    line-height: 12px;
    letter-spacing: 0;
    text-transform: uppercase;
    pointer-events: none;
  }

  .remelle-pdp__buy {
    flex: 1 1 548px;
    max-width: 548px;
    min-width: 0;
  }

  .remelle-pdp__heading,
  .remelle-pdp__option--color,
  .remelle-pdp__quantity {
    max-width: 410px;
  }

  .remelle-pdp__title {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 36px;
    font-weight: 400;
    line-height: 36px;
    letter-spacing: -0.02em;
  }

  .remelle-pdp__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-top: 6px;
  }

  .remelle-pdp__price {
    margin: 0;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 600;
    line-height: 24px;
  }

  .remelle-pdp__compare {
    color: #8a8178;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 400;
    line-height: 24px;
  }

  .remelle-pdp__compare--hidden,
  .remelle-pdp__compare[hidden] {
    display: none;
  }

  .remelle-pdp__errors {
    margin: 16px 0 0;
    padding: 12px 14px;
    border: 1px solid var(--color-burgundy);
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.4;
  }

  .remelle-pdp__unavailable {
    margin: 16px 0 0;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.4;
  }

  .remelle-pdp__unavailable[hidden],
  .remelle-pdp__status[hidden],
  .remelle-pdp__errors[hidden] {
    display: none;
  }

  .remelle-pdp__status {
    margin: 16px 0 0;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.4;
  }

  .remelle-pdp__choice--unavailable {
    opacity: 0.4;
  }

  .remelle-pdp__dynamic {
    margin-top: 12px;
    --shopify-accelerated-checkout-button-block-size: 44px;
    --shopify-accelerated-checkout-button-border-radius: 0px;
    --shopify-accelerated-checkout-button-box-shadow: none;
    --shopify-accelerated-checkout-skeleton-background-color: var(--color-beige);
  }

  .remelle-pdp__dynamic .shopify-payment-button__button--unbranded {
    min-height: 44px !important;
    border: 1px solid var(--color-burgundy) !important;
    border-radius: 0 !important;
    background: var(--color-burgundy) !important;
    box-shadow: none !important;
