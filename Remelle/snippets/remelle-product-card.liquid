{% doc %}
  Product card. The homepage carousel uses 363 by 550. The shop grid uses 323 by 497.

  @param {product} product - Product to render
  @param {string} [layout] - Pass shop for the listing grid card
  @param {boolean} [show_new_badge] - When false, the New in badge stays hidden
  @param {string} [badge_label] - New in badge text
  @param {string} [badge_tag] - Product tag that shows New in
  @param {boolean} [show_sale_badge] - When false, the Sale badge stays hidden
  @param {string} [sale_label] - Sale badge text
  @param {string} [sale_tag] - Product tag that shows Sale

  @example
  {% render 'remelle-product-card', product: product, show_new_badge: true, badge_label: 'New in', badge_tag: 'new', show_sale_badge: true, sale_label: 'Sale', sale_tag: 'sale' %}
{% enddoc %}

{%- liquid
  assign card_title = product.title
  assign card_url = product.url
  assign card_price = product.price
  assign card_image = product.featured_image
  assign card_alt = card_image.alt | default: product.title
  assign color_option = nil
  assign show_new = false
  assign show_sale = false
  assign new_tag_setting = badge_tag | downcase | strip
  assign sale_tag_setting = sale_tag | downcase | strip

  if show_new_badge and badge_label != blank
    assign show_new = true
    if new_tag_setting != blank
      assign saw_tag = false
      assign matched_new = false
      assign new_terms = new_tag_setting | split: ','
      for tag in product.tags
        assign saw_tag = true
        assign tag_value = tag | downcase | strip
        for term in new_terms
          assign term_value = term | strip
          if tag_value == term_value
            assign matched_new = true
          endif
          if term_value == 'new' and tag_value == 'new in'
            assign matched_new = true
          endif
        endfor
      endfor
      if saw_tag
        assign show_new = matched_new
      endif
    endif
  endif

  if show_sale_badge and sale_label != blank
    assign show_sale = true
    if sale_tag_setting != blank
      assign saw_sale_tag = false
      assign matched_sale = false
      assign sale_terms = sale_tag_setting | split: ','
      for tag in product.tags
        assign saw_sale_tag = true
        assign tag_value = tag | downcase | strip
        for term in sale_terms
          assign term_value = term | strip
          if tag_value == term_value
            assign matched_sale = true
          endif
        endfor
      endfor
      if saw_sale_tag
        assign show_sale = matched_sale
      endif
    endif
  endif

  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'color' or option_name == 'colour'
      assign color_option = option
    endif
  endfor
-%}

<article class="remelle-card{% if layout == 'shop' %} remelle-card--shop{% endif %}">
  <div class="remelle-card__photo">
    <a class="remelle-card__media" href="{{ card_url }}">
      {%- if card_image != blank -%}
        {{
          card_image
          | image_url: width: 800
          | image_tag:
            widths: '363, 726',
            sizes: '363px',
            alt: card_alt,
            class: 'remelle-card__image',
            loading: 'lazy'
        }}
      {%- endif -%}
    </a>

    {%- if show_new or show_sale -%}
      <div class="remelle-card__badges">
        {%- if show_new -%}
          <p class="remelle-card__badge">{{ badge_label | escape }}</p>
        {%- endif -%}
        {%- if show_sale -%}
          <p class="remelle-card__badge remelle-card__badge--sale">{{ sale_label | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <button class="remelle-card__wish" type="button" aria-pressed="false" aria-label="{{ 'products.wishlist' | t }}">
      {% render 'icon-heart' %}
    </button>

    {%- liquid
      assign quick_variant = product.selected_or_first_available_variant
      assign quick_available = false
      if quick_variant and quick_variant.available
        assign quick_available = true
      endif
    -%}
    {%- if product.has_only_default_variant and quick_variant -%}
      {% form 'product', product, class: 'remelle-card__form' %}
        <input type="hidden" name="id" value="{{ quick_variant.id }}">
        <button
          class="remelle-card__add"
          type="submit"
          {% if quick_available %}
            aria-label="{{ 'products.add' | t: title: card_title }}"
          {% else %}
            aria-label="{{ 'product.sold_out' | t }}"
            disabled
          {% endif %}
        >
          {% render 'icon-plus' %}
        </button>
      {% endform %}
    {%- elsif quick_variant -%}
      <a
        class="remelle-card__add remelle-card__add--link"
        href="{{ card_url }}"
        aria-label="{{ 'products.choose_options' | t: title: card_title }}"
      >
        {% render 'icon-plus' %}
      </a>
    {%- endif -%}
  </div>

  <h3 class="remelle-card__name">
    <a href="{{ card_url }}">{{ card_title | escape }}</a>
  </h3>

  <div class="remelle-card__meta">
    <p class="remelle-card__price">{{ card_price | money }}</p>
    {%- if color_option -%}
      <ul class="remelle-card__swatches">
        {%- for value in color_option.values limit: 2 -%}
          {%- liquid
            assign swatch_color = value.swatch.color
            if swatch_color == blank
              assign swatch_name = value.name | downcase
              case swatch_name
                when 'burgundy'
                  assign swatch_color = '#670D0D'
                when 'black'
                  assign swatch_color = '#060505'
                when 'off white', 'cream', 'ivory', 'white'
                  assign swatch_color = '#F3EDE4'
                when 'brown'
                  assign swatch_color = '#6A4A38'
                else
                  assign swatch_color = '#D0CBC4'
              endcase
            endif
          -%}
          <li class="remelle-card__swatch" style="background: {{ swatch_color }};">
            <span class="remelle-card__swatch-label">{{ value.name | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
      {%- if color_option.values.size > 2 -%}
        <p class="remelle-card__more">+ {{ color_option.values.size | minus: 2 }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .remelle-card {
    flex: 0 0 363px;
    width: 363px;
    color: #242424;
  }

  .remelle-card.remelle-card--shop {
    flex: none;
    width: 323px;
  }

  .remelle-card.remelle-card--shop .remelle-card__photo {
    height: 431px;
  }

  @media (max-width: 768px) {
    .remelle-card,
    .remelle-card.remelle-card--shop {
      flex: 1 1 calc(50% - 8px);
      width: calc(50% - 8px);
      max-width: 323px;
    }

    .remelle-card__photo,
    .remelle-card.remelle-card--shop .remelle-card__photo {
      height: auto;
      aspect-ratio: 323 / 431;
    }
  }

  @media (max-width: 414px) {
    .remelle-card,
    .remelle-card.remelle-card--shop {
      flex: 1 1 100%;
      width: 100%;
      max-width: none;
    }
  }

  .remelle-card__photo {
    position: relative;
    height: 484px;
    background: var(--color-beige);
  }

  .remelle-card__media {
    display: block;
    height: 100%;
    padding: 10px;
  }

  .remelle-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .remelle-card__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .remelle-card__badge {
    margin: 0;
    padding: 2px 6px;
    border-radius: var(--radius-badge);
    background: #ffffff;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    line-height: 12px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .remelle-card__badge--sale {
    background: var(--color-burgundy);
    color: var(--color-off-white);
  }

  .remelle-card__wish,
  .remelle-card__add {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
  }

  .remelle-card__wish {
    top: 10px;
    right: 10px;
    width: 20px;
    height: 20px;
    border: 0;
    background: transparent;
    color: var(--color-burgundy);
  }

  .remelle-card__wish[aria-pressed='true'] .icon-heart path {
    fill: currentColor;
  }

  .remelle-card__form {
    margin: 0;
  }

  .remelle-card__add {
    right: 10px;
    bottom: 10px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--color-burgundy);
    color: var(--color-off-white);
  }

  .remelle-card__add:disabled {
    opacity: 0.35;
    cursor: default;
  }

  a.remelle-card__add--link {
    text-decoration: none;
  }

  .remelle-card__wish:focus-visible,
  .remelle-card__add:focus-visible,
  .remelle-card__name a:focus-visible,
  .remelle-card__media:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  .remelle-card__name {
    margin: 20px 0 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .remelle-card__name a {
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .remelle-card__meta {
    display: flex;
    align-items: center;
    height: 17px;
    margin-top: 12px;
  }

  .remelle-card__price {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    line-height: 17px;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .remelle-card__swatches {
    display: flex;
    margin: 0 0 0 17px;
    padding: 0;
    list-style: none;
  }

  .remelle-card__swatch {
    position: relative;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-swatch);
  }

  .remelle-card__swatch + .remelle-card__swatch {
    margin-left: -4px;
  }

  .remelle-card__swatch-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .remelle-card__more {
    margin: 0 0 0 4px;
    color: #242424;
    font-family: Inter, var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: nowrap;
  }
{% endstylesheet %}
