{%- liquid
  assign product_collection = section.settings.collection
  if product_collection == blank and collections.all.products_count > 0
    assign product_collection = collections.all
  endif

  assign view_all_url = routes.all_products_collection_url
  if section.settings.collection != blank
    assign view_all_url = section.settings.collection.url
  endif

  assign picked_products = section.settings.products
  assign show_picked = false
  assign show_products = false
  if picked_products != blank and picked_products.size > 0
    assign show_picked = true
    assign show_products = true
  elsif product_collection != blank and product_collection.products_count > 0
    assign show_products = true
  endif
-%}

<section
  class="remelle-products"
  {% if section.settings.heading != blank %}
    aria-labelledby="RemelleProductsTitle-{{ section.id }}"
  {% endif %}
>
  <div class="remelle-products__header">
    <div class="remelle-products__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="remelle-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="remelle-products__heading" id="RemelleProductsTitle-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
    </div>
    {%- if section.settings.view_all_label != blank -%}
      <a class="remelle-products__view-all" href="{{ view_all_url }}">
        {{ section.settings.view_all_label | escape }}
        {% render 'icon-arrow-up-right' %}
      </a>
    {%- endif -%}
  </div>

  {%- if show_products -%}
    <div class="remelle-products__track" tabindex="0">
      {%- if show_picked -%}
        {%- for product in picked_products limit: section.settings.products_to_show -%}
          {% render 'remelle-product-card',
            product: product,
            show_new_badge: section.settings.show_new_badge,
            badge_label: section.settings.badge_label,
            badge_tag: section.settings.badge_tag,
            new_products: section.settings.new_products,
            show_sale_badge: section.settings.show_sale_badge,
            sale_label: section.settings.sale_label,
            sale_tag: section.settings.sale_tag,
            sale_products: section.settings.sale_products,
            show_limited_badge: section.settings.show_limited_badge,
            limited_label: section.settings.limited_label,
            limited_tag: section.settings.limited_tag,
            limited_products: section.settings.limited_products,
            show_preorder_badge: section.settings.show_preorder_badge,
            preorder_label: section.settings.preorder_label,
            preorder_tag: section.settings.preorder_tag,
            preorder_products: section.settings.preorder_products,
            show_coming_soon_badge: section.settings.show_coming_soon_badge,
            coming_soon_label: section.settings.coming_soon_label,
            coming_soon_tag: section.settings.coming_soon_tag,
            coming_soon_products: section.settings.coming_soon_products,
            show_low_stock_badge: section.settings.show_low_stock_badge,
            low_stock_label: section.settings.low_stock_label,
            low_stock_threshold: section.settings.low_stock_threshold,
            low_stock_products: section.settings.low_stock_products
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for product in product_collection.products limit: section.settings.products_to_show -%}
          {% render 'remelle-product-card',
            product: product,
            show_new_badge: section.settings.show_new_badge,
            badge_label: section.settings.badge_label,
            badge_tag: section.settings.badge_tag,
            new_products: section.settings.new_products,
            show_sale_badge: section.settings.show_sale_badge,
            sale_label: section.settings.sale_label,
            sale_tag: section.settings.sale_tag,
            sale_products: section.settings.sale_products,
            show_limited_badge: section.settings.show_limited_badge,
            limited_label: section.settings.limited_label,
            limited_tag: section.settings.limited_tag,
            limited_products: section.settings.limited_products,
            show_preorder_badge: section.settings.show_preorder_badge,
            preorder_label: section.settings.preorder_label,
            preorder_tag: section.settings.preorder_tag,
            preorder_products: section.settings.preorder_products,
            show_coming_soon_badge: section.settings.show_coming_soon_badge,
            coming_soon_label: section.settings.coming_soon_label,
            coming_soon_tag: section.settings.coming_soon_tag,
            coming_soon_products: section.settings.coming_soon_products,
            show_low_stock_badge: section.settings.show_low_stock_badge,
            low_stock_label: section.settings.low_stock_label,
            low_stock_threshold: section.settings.low_stock_threshold,
            low_stock_products: section.settings.low_stock_products
          %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="remelle-products__controls">
      <div
        class="remelle-products__progress"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-label="{{ 'products.progress' | t }}"
      >
        <span class="remelle-products__progress-fill"></span>
      </div>
      <div class="remelle-products__arrows">
        <button class="remelle-products__arrow" type="button" data-direction="prev" aria-label="{{ 'products.previous' | t }}">
          {% render 'icon-arrow-left' %}
        </button>
        <button class="remelle-products__arrow" type="button" data-direction="next" aria-label="{{ 'products.next' | t }}">
          {% render 'icon-arrow-right' %}
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .remelle-products {
    background: var(--color-off-white);
    padding: 80px 0 48px;
    overflow: hidden;
  }

  .remelle-products__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .remelle-products__eyebrow {
    margin: 0 0 20px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-products__heading {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .remelle-products__view-all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0 4px;
    border-bottom: 1px solid var(--color-burgundy);
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    line-height: 12px;
    letter-spacing: 1.6px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .remelle-products__view-all:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  .remelle-products__track {
    display: flex;
    gap: 16px;
    width: min(var(--page-content), calc(100% - (var(--page-inset) * 2)));
    margin: 48px auto 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .remelle-products__track::-webkit-scrollbar {
    display: none;
  }

  .remelle-products__controls[hidden] {
    display: none;
  }

  .remelle-products__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(var(--page-width), 100%);
    height: 32px;
    margin: 32px auto 0;
    padding-inline: var(--page-inset);
  }

  .remelle-products__progress {
    width: min(862px, calc(100% - 96px));
    height: 1px;
    background: rgba(103, 13, 13, 0.25);
  }

  .remelle-products__progress-fill {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-burgundy);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .remelle-products__arrows {
    display: flex;
    justify-content: space-between;
    width: 80px;
  }

  .remelle-products__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-burgundy);
    cursor: pointer;
  }

  .remelle-products__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .remelle-products__arrow:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .remelle-products {
      padding-top: 56px;
    }

    .remelle-products__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .remelle-products__heading {
      font-size: 40px;
      line-height: 1.05;
    }

    .remelle-products__track {
      margin-top: 32px;
      scroll-padding-inline: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .remelle-products__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.remelle-products').forEach((section) => {
    if (section.dataset.carouselReady === 'true') return;
    section.dataset.carouselReady = 'true';
    const track = section.querySelector('.remelle-products__track');
    const fill = section.querySelector('.remelle-products__progress-fill');
    const progress = section.querySelector('.remelle-products__progress');
    const previous = section.querySelector('[data-direction="prev"]');
    const next = section.querySelector('[data-direction="next"]');
    const controls = section.querySelector('.remelle-products__controls');
    if (!track) return;

    const mobileQuery = window.matchMedia('(max-width: 768px)');
    const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const AUTOPLAY_MS = 5000;
    const RESUME_MS = 5500;
    let autoplayTimer = null;
    let resumeTimer = null;
    let inView = true;
    let userPaused = false;

    const cards = () => [...track.querySelectorAll('.remelle-card')];

    const maxScroll = () => Math.max(0, track.scrollWidth - track.clientWidth);

    const update = () => {
      if (!fill || !progress) return;
      const max = maxScroll();
      const canScroll = max > 8;
      if (controls) controls.hidden = !canScroll;
      const ratio = track.scrollWidth === 0 ? 0 : (track.clientWidth + track.scrollLeft) / track.scrollWidth;
      const amount = Math.max(0, Math.min(1, ratio));
      fill.style.transform = `scaleX(${amount})`;
      progress.setAttribute('aria-valuenow', String(Math.round(amount * 100)));
      if (previous) previous.disabled = !canScroll ? true : track.scrollLeft <= 1 && !mobileQuery.matches;
      if (next) next.disabled = !canScroll;
      if (mobileQuery.matches && canScroll) {
        if (previous) previous.disabled = false;
        if (next) next.disabled = false;
      }
    };

    const step = () => {
      const list = cards();
      if (!list.length) return 379;
      const first = list[0];
      const gap = 16;
      // Prefer offsetWidth so layout is ready even before paint settles.
      const width = first.offsetWidth || first.getBoundingClientRect().width;
      return Math.max(1, Math.round(width + gap));
    };

    const scrollByStep = (direction) => {
      const max = maxScroll();
      if (max <= 8) return;
      const delta = step() * direction;
      const current = track.scrollLeft;
      if (direction > 0 && current >= max - 4) {
        track.scrollTo({ left: 0, behavior: reduceQuery.matches ? 'auto' : 'smooth' });
        return;
      }
      if (direction < 0 && current <= 4) {
        track.scrollTo({ left: max, behavior: reduceQuery.matches ? 'auto' : 'smooth' });
        return;
      }
      const target = Math.max(0, Math.min(max, current + delta));
      track.scrollTo({ left: target, behavior: reduceQuery.matches ? 'auto' : 'smooth' });
    };

    const stopAutoplay = () => {
      if (autoplayTimer) {
        window.clearTimeout(autoplayTimer);
        autoplayTimer = null;
      }
    };

    const canAutoplay = () =>
      mobileQuery.matches &&
      !reduceQuery.matches &&
      document.visibilityState !== 'hidden' &&
      inView &&
      !userPaused &&
      cards().length > 1 &&
      maxScroll() > 8;

    const scheduleNext = () => {
      stopAutoplay();
      if (!canAutoplay()) return;
      autoplayTimer = window.setTimeout(() => {
        autoplayTimer = null;
        if (!canAutoplay()) return;
        scrollByStep(1);
        scheduleNext();
      }, AUTOPLAY_MS);
    };

    const startAutoplay = () => {
      userPaused = false;
      if (resumeTimer) {
        window.clearTimeout(resumeTimer);
        resumeTimer = null;
      }
      update();
      scheduleNext();
    };

    const pauseAutoplay = () => {
      userPaused = true;
      stopAutoplay();
      if (resumeTimer) window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        userPaused = false;
        startAutoplay();
      }, RESUME_MS);
    };

    if (previous) {
      previous.addEventListener('click', () => {
        pauseAutoplay();
        scrollByStep(-1);
      });
    }
    if (next) {
      next.addEventListener('click', () => {
        pauseAutoplay();
        scrollByStep(1);
      });
    }

    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('pointerdown', pauseAutoplay, { passive: true });
    track.addEventListener('touchstart', pauseAutoplay, { passive: true });
    track.addEventListener('wheel', pauseAutoplay, { passive: true });
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') pauseAutoplay();
    });

    const onViewportChange = () => {
      update();
      if (canAutoplay()) startAutoplay();
      else stopAutoplay();
    };

    if (typeof mobileQuery.addEventListener === 'function') {
      mobileQuery.addEventListener('change', onViewportChange);
      reduceQuery.addEventListener('change', onViewportChange);
    } else if (typeof mobileQuery.addListener === 'function') {
      mobileQuery.addListener(onViewportChange);
      reduceQuery.addListener(onViewportChange);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') stopAutoplay();
      else startAutoplay();
    });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            inView = entry.isIntersecting && entry.intersectionRatio > 0.2;
            if (inView) startAutoplay();
            else stopAutoplay();
          });
        },
        { threshold: [0, 0.2, 0.5] }
      );
      io.observe(section);
    }

    update();
    window.addEventListener('resize', () => {
      update();
      if (canAutoplay() && !autoplayTimer && !userPaused) startAutoplay();
    });

    // Layout may not be scrollable on the first tick (fonts/images). Retry briefly.
    let tries = 0;
    const boot = () => {
      update();
      if (canAutoplay()) {
        startAutoplay();
        return;
      }
      tries += 1;
      if (tries < 20) window.setTimeout(boot, 250);
    };
    window.requestAnimationFrame(boot);
    window.addEventListener('load', () => {
      update();
      startAutoplay();
    });
  });
{% endjavascript %}

{% schema %}
{
