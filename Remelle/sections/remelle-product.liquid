{% javascript %}
  document.querySelectorAll('.remelle-pdp').forEach((section) => {
    const data = section.querySelector('[data-product-variants]');
    if (!data) return;
    const variants = JSON.parse(data.textContent);
    const idInput = section.querySelector('[data-variant-id]');
    const price = section.querySelector('[data-product-price]');
    const compare = section.querySelector('[data-product-compare]');
    const add = section.querySelector('[data-add]');
    const unavailable = section.querySelector('[data-unavailable]');
    const quantity = section.querySelector('[data-qty-input]');
    const gallerySlides = [...section.querySelectorAll('[data-gallery-slide]')];
    const galleryThumbs = [...section.querySelectorAll('[data-gallery-thumb]')];
    const galleryThumbRow = section.querySelector('[data-gallery-thumbs]');
    const galleryStage = section.querySelector('.remelle-pdp__stage');
    const galleryPrev = section.querySelector('[data-gallery-prev]');
    const galleryNext = section.querySelector('[data-gallery-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = Math.max(0, gallerySlides.findIndex((slide) => slide.classList.contains('is-active')));
    let galleryTimer = 0;
    let galleryPaused = false;
    let galleryHovering = false;

    const setGalleryIndex = (index) => {
      if (!gallerySlides.length) return;
      const count = gallerySlides.length;
      activeIndex = ((index % count) + count) % count;
      gallerySlides.forEach((slide, slideIndex) => {
        const active = slideIndex === activeIndex;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      galleryThumbs.forEach((thumb, thumbIndex) => {
        const active = thumbIndex === activeIndex;
        thumb.classList.toggle('is-active', active);
        if (active) thumb.setAttribute('aria-current', 'true');
        else thumb.removeAttribute('aria-current');
      });
      const activeThumb = galleryThumbs[activeIndex];
      if (galleryThumbRow && activeThumb) {
        const left = activeThumb.offsetLeft - (galleryThumbRow.clientWidth - activeThumb.clientWidth) / 2;
        galleryThumbRow.scrollTo({ left: Math.max(0, left), behavior: reduceMotion ? 'auto' : 'smooth' });
      }
    };

    const restartGallery = () => {
      window.clearInterval(galleryTimer);
      if (reduceMotion || gallerySlides.length < 2) return;
      galleryTimer = window.setInterval(() => {
        if (galleryPaused || document.hidden) return;
        setGalleryIndex(activeIndex + 1);
      }, 3000);
    };

    const showGalleryImage = (imageId, animate) => {
      if (imageId == null) return;
      const index = gallerySlides.findIndex((node) => node.getAttribute('data-image-id') === String(imageId));
      if (index < 0) return;
      setGalleryIndex(index);
      if (animate) restartGallery();
    };

    if (gallerySlides.length > 1 && galleryStage) {
      if (galleryPrev) {
        galleryPrev.addEventListener('click', () => {
          setGalleryIndex(activeIndex - 1);
          restartGallery();
        });
      }
      if (galleryNext) {
        galleryNext.addEventListener('click', () => {
          setGalleryIndex(activeIndex + 1);
          restartGallery();
        });
      }
      galleryThumbs.forEach((thumb, index) => {
        thumb.addEventListener('click', () => {
          setGalleryIndex(index);
          restartGallery();
        });
      });

      let swipeStart = null;
      galleryStage.addEventListener('pointerdown', (event) => {
        if (event.target.closest('.remelle-pdp__nav')) return;
        swipeStart = event.clientX;
        galleryPaused = true;
      });
      const endSwipe = (event) => {
        if (swipeStart != null && event) {
          const delta = event.clientX - swipeStart;
          if (Math.abs(delta) > 36) setGalleryIndex(activeIndex + (delta < 0 ? 1 : -1));
        }
        swipeStart = null;
        galleryPaused = galleryHovering;
        restartGallery();
      };
      galleryStage.addEventListener('pointerup', endSwipe);
      galleryStage.addEventListener('pointercancel', () => endSwipe(null));
      galleryStage.addEventListener('mouseenter', () => {
        galleryHovering = true;
        galleryPaused = true;
      });
      galleryStage.addEventListener('mouseleave', () => {
        galleryHovering = false;
        galleryPaused = false;
      });
      galleryStage.addEventListener('focusin', () => {
        galleryPaused = true;
      });
      galleryStage.addEventListener('focusout', () => {
        galleryPaused = galleryHovering;
      });
    }
    const dynamicCheckout = section.querySelector('[data-dynamic-checkout]');

    const selectedOptions = () =>
      [...section.querySelectorAll('[data-option]:checked')]
        .sort((a, b) => Number(a.name.replace('option-', '')) - Number(b.name.replace('option-', '')))
        .map((input) => input.value);

    const markOptionAvailability = (chosen) => {
      section.querySelectorAll('[data-option]').forEach((input) => {
        const optionIndex = Number(input.name.replace('option-', '')) - 1;
        const trial = chosen.slice();
        trial[optionIndex] = input.value;
        const match = variants.find((item) => item.options.every((option, index) => option === trial[index]));
        const label = input.closest('.remelle-pdp__choice');
        const isAvailable = Boolean(match && match.available);
        input.disabled = !match;
        if (label) label.classList.toggle('remelle-pdp__choice--unavailable', !isAvailable);
      });
    };

    const syncQuantityBounds = (variant) => {
      if (!quantity || !variant) return;
      const tracked =
        variant.inventory_management &&
        variant.inventory_policy === 'deny' &&
        typeof variant.inventory_quantity === 'number' &&
        variant.inventory_quantity > 0;
      if (tracked) {
        quantity.max = String(variant.inventory_quantity);
        if (Number(quantity.value) > variant.inventory_quantity) {
          quantity.value = String(variant.inventory_quantity);
        }
      } else {
        quantity.removeAttribute('max');
      }
    };

    const sync = () => {
      const chosen = selectedOptions();
      markOptionAvailability(chosen);
      const variant = variants.find((item) => item.options.every((option, index) => option === chosen[index]));

      const preorderNote = section.querySelector('[data-preorder-note]');
      const deliveryNote = section.querySelector('[data-delivery-note]');
      const labelFor = (item) => {
        if (item && item.preorder && add && add.dataset.preorderLabel) return add.dataset.preorderLabel;
        if (add && add.dataset.basketLabel) return add.dataset.basketLabel;
        return add ? add.dataset.label : '';
      };
      const syncShippingNotes = (item) => {
        const isPreorder = Boolean(item && item.available && item.preorder);
        const isInStock = Boolean(item && item.available && !item.preorder);
        if (preorderNote) preorderNote.hidden = !isPreorder;
        if (deliveryNote) deliveryNote.hidden = !isInStock;
      };

      if (!variant) {
        if (idInput) idInput.value = '';
        if (add) {
          add.disabled = true;
          add.textContent = add.dataset.unavailableLabel || add.dataset.soldOut;
        }
        syncShippingNotes(null);
        if (unavailable) unavailable.hidden = false;
        if (dynamicCheckout) dynamicCheckout.hidden = true;
        if (compare) {
          compare.hidden = true;
          compare.textContent = '';
        }
        return;
      }

      if (unavailable) unavailable.hidden = true;
      if (idInput) idInput.value = String(variant.id);
      if (price) price.textContent = variant.price;
      if (compare) {
        if (variant.compare_at_price) {
          compare.hidden = false;
          compare.classList.remove('remelle-pdp__compare--hidden');
          compare.textContent = variant.compare_at_price;
        } else {
          compare.hidden = true;
          compare.textContent = '';
        }
      }
      if (add) {
        const label = labelFor(variant);
        add.dataset.label = label;
        add.disabled = !variant.available;
        add.textContent = variant.available ? label : add.dataset.soldOut;
      }
      syncShippingNotes(variant);
      if (dynamicCheckout) dynamicCheckout.hidden = !variant.available;
      if (variant.image_id) showGalleryImage(variant.image_id, galleryReady);
      syncQuantityBounds(variant);

      const url = new URL(window.location.href);
      url.searchParams.set('variant', String(variant.id));
      window.history.replaceState({}, '', url.toString());

      const colorCurrent = section.querySelector('[data-color-current]');
      const colorInput = section.querySelector('.remelle-pdp__option--color [data-option]:checked');
      if (colorCurrent && colorInput) colorCurrent.textContent = colorInput.value;
    };

    section.querySelectorAll('[data-option]').forEach((input) => {
      input.addEventListener('change', sync);
    });

    section.querySelectorAll('[data-qty]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!quantity) return;
        const max = quantity.max ? Number(quantity.max) : Infinity;
        const next = Math.max(1, Math.min(max, Number(quantity.value || 1) + Number(button.dataset.qty)));
        quantity.value = String(next);
      });
    });

    let galleryReady = false;
    sync();
    galleryReady = true;
    restartGallery();

    // On right-click only: quietly swap the active image to a JPEG blob so the
    // browser's native "Save image as…" can download .jpg — no auto-download,
    // and the normal context menu stays intact.
    const galleryRoot = section.querySelector('.remelle-pdp__gallery');
    if (galleryRoot) {
      const toJpegBlob = async (img) => {
        if (!img || img.dataset.remelleJpeg === '1' || img.dataset.remelleJpegPending === '1') return;
        const source = img.currentSrc || img.src;
        if (!source || source.startsWith('blob:') || !/\/cdn\/shop\//.test(source)) return;

        img.dataset.remelleJpegPending = '1';
        try {
          const url = new URL(source, window.location.href);
          url.searchParams.set('format', 'jpg');
          url.searchParams.set('width', '2000');
          const response = await fetch(url.href, {
            mode: 'cors',
            credentials: 'omit',
            headers: { Accept: 'image/jpeg,image/*,*/*;q=0.8' }
          });
          if (!response.ok) return;
          const raw = await response.blob();
          const bitmap = await createImageBitmap(raw);
          const canvas = document.createElement('canvas');
          canvas.width = bitmap.width;
          canvas.height = bitmap.height;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            bitmap.close();
            return;
          }
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(bitmap, 0, 0);
          bitmap.close();
          const jpeg = await new Promise((resolve) => {
            canvas.toBlob(resolve, 'image/jpeg', 0.92);
          });
          if (!jpeg || !img.isConnected) return;
          const objectUrl = URL.createObjectURL(jpeg);
          const previous = img.dataset.remelleBlob;
          img.removeAttribute('srcset');
          img.removeAttribute('sizes');
          img.src = objectUrl;
          img.dataset.remelleJpeg = '1';
          img.dataset.remelleBlob = objectUrl;
          if (previous) URL.revokeObjectURL(previous);
        } catch (_) {
          /* leave the original image alone */
        } finally {
          delete img.dataset.remelleJpegPending;
        }
      };

      galleryRoot.addEventListener('contextmenu', () => {
        const activeImage =
          galleryRoot.querySelector('.remelle-pdp__slide.is-active .remelle-pdp__image') ||
          galleryRoot.querySelector('.remelle-pdp__image');
        toJpegBlob(activeImage);
      });
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "add_label",
      "label": "t:labels.button_label",
      "default": "Add to basket"
    },
    {
      "type": "text",
      "id": "preorder_button_label",
      "label": "t:labels.preorder_button_label",
      "info": "t:labels.preorder_button_label_info",
      "default": "Pre order"
    },
    {
      "type": "textarea",
      "id": "preorder_size_rules",
      "label": "t:labels.preorder_size_rules",
      "info": "t:labels.preorder_size_rules_info"
    },
    {
      "type": "text",
      "id": "preorder_note",
      "label": "t:labels.preorder_note",
      "info": "t:labels.preorder_note_info",
      "default": "Preorder takes from 10 to 20 days."
    },
    {
      "type": "text",
      "id": "delivery_note",
      "label": "t:labels.delivery_note",
      "info": "t:labels.delivery_note_info",
      "default": "Delivery within 2 to 3 days."
    },
    {
