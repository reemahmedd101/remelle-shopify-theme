{% doc %}
  Loads the Remelle brand fonts and writes the global design tokens.

  Instrument Sans is the body and UI face. Instrument Serif is the display
  and section-heading face. Snell Roundhand is self-hosted for the phrase
  "Intention & authenticity" so it renders on every device.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  @font-face {
    font-family: "Instrument Sans";
    src: url("{{ 'instrument-sans.woff2' | asset_url }}") format("woff2");
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
    font-stretch: 100%;
  }

  @font-face {
    font-family: "Instrument Serif";
    src: url("{{ 'instrument-serif.woff2' | asset_url }}") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Snell Roundhand";
    src: url("{{ 'snell-roundhand-regular.ttf' | asset_url }}") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-sans: "Instrument Sans", sans-serif;
    --font-serif: "Instrument Serif", serif;
    --font-script: "Snell Roundhand", cursive;

    --color-burgundy: {{ settings.color_burgundy }};
    --color-beige: {{ settings.color_beige }};
    --color-off-white: {{ settings.color_off_white }};
    --color-black: {{ settings.color_black }};

    --page-width: {{ settings.page_width }}px;
    --page-inset: {{ settings.page_inset }}px;
    --page-content: calc(var(--page-width) - (var(--page-inset) * 2));
    --header-announcement-height: {{ settings.announcement_height }}px;
    --header-nav-height: {{ settings.navigation_height }}px;
    --header-height: calc(var(--header-announcement-height) + var(--header-nav-height));

    --radius-none: 0;
    --radius-badge: 1px;
    --radius-control: 2px;
    --radius-swatch: 50%;
  }
{% endstyle %}
