<section class="remelle-listing remelle-listing--collections" aria-labelledby="RemelleCollectionsTitle-{{ section.id }}">
  <div class="remelle-listing__header">
    <div class="remelle-listing__intro">
      <h1 class="remelle-listing__title" id="RemelleCollectionsTitle-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading | escape }}
        {%- else -%}
          {{ 'collections.title' | t }}
        {%- endif -%}
      </h1>
    </div>
  </div>

  {%- if collections.size == 0 -%}
    <p class="remelle-listing__empty">{{ 'collections.empty' | t }}</p>
  {%- else -%}
    <div class="remelle-listing__grid remelle-listing__grid--collections">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'all' and section.settings.hide_all_collection -%}
          <a class="remelle-collection-card" href="{{ collection.url }}">
            <div class="remelle-collection-card__media">
              {%- if collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 800
                  | image_tag:
                    widths: '323, 646',
                    sizes: '(max-width: 768px) 50vw, 323px',
                    alt: collection.title,
                    class: 'remelle-collection-card__image',
                    loading: 'lazy'
                }}
              {%- endif -%}
            </div>
            <h2 class="remelle-collection-card__title">{{ collection.title | escape }}</h2>
            {%- if collection.description != blank and section.settings.show_description -%}
              <p class="remelle-collection-card__copy">
                {{ collection.description | strip_html | truncatewords: 18 | escape }}
              </p>
            {%- endif -%}
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .remelle-listing__grid--collections {
    gap: 48px 16px;
  }

  .remelle-collection-card {
    display: block;
    width: 323px;
    color: inherit;
    text-decoration: none;
  }

  .remelle-collection-card__media {
    aspect-ratio: 323 / 431;
    background: var(--color-beige);
    overflow: hidden;
  }

  .remelle-collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .remelle-collection-card__title {
    margin: 20px 0 0;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
  }

  .remelle-collection-card__copy {
    margin: 8px 0 0;
    color: #8a8178;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.4;
  }

  .remelle-collection-card:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .remelle-collection-card {
      width: calc(50% - 8px);
    }
  }

  @media (max-width: 600px) {
    .remelle-collection-card {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections",
  "enabled_on": {
    "templates": ["list-collections"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Collections"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:labels.description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_all_collection",
      "label": "t:labels.hide_all_collection",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.collections"
    }
  ]
}
{% endschema %}
