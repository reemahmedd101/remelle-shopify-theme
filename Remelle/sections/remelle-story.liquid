<section
  class="remelle-story"
  {% if section.settings.heading != blank %}
    aria-labelledby="RemelleStoryTitle-{{ section.id }}"
  {% endif %}
>
  <div class="remelle-story__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="remelle-story__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="remelle-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="remelle-story__heading" id="RemelleStoryTitle-{{ section.id }}">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="remelle-story__row">
      <div class="remelle-story__media">
        {%- if section.settings.image != blank -%}
          {%- assign story_alt = section.settings.image_alt | default: section.settings.image.alt -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 700, 1000, 1400',
              sizes: '(min-width: 1440px) 662px, 50vw',
              alt: story_alt,
              class: 'remelle-story__image',
              loading: 'lazy'
          }}
        {%- else -%}
          <img
            class="remelle-story__image"
            src="{{ 'Story image frame.png' | asset_url }}"
            alt="{{ section.settings.image_alt | escape }}"
            width="662"
            height="624"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <div class="remelle-story__copy">
        {%- if section.settings.statement != blank -%}
          <p class="remelle-story__statement">{{ section.settings.statement | escape }}</p>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="remelle-story__body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          {%- liquid
            assign story_link = section.settings.button_link
            if story_link == blank
              assign story_link = pages.about.url | default: '/pages/about'
            endif
          -%}
          <a class="remelle-story__button" href="{{ story_link }}">
            {{ section.settings.button_label | escape }}
            {% render 'icon-arrow-up-right' %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .remelle-story {
    background: #fbf7f1;
    color: #241715;
    padding-block: 80px;
  }

  .remelle-story__inner {
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .remelle-story__eyebrow {
    margin: 0 0 20px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-story__heading {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .remelle-story__row {
    display: flex;
    align-items: center;
    gap: 88px;
    margin-top: 48px;
  }

  .remelle-story__header:empty + .remelle-story__row,
  .remelle-story__row:first-child {
    margin-top: 0;
  }

  .remelle-story__media {
    flex: 0 1 662px;
    width: 662px;
    max-width: 100%;
    aspect-ratio: 662 / 624;
    background: #c5c0b8;
    overflow: hidden;
  }

  .remelle-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .remelle-story__copy {
    flex: 0 1 530px;
    width: 530px;
    max-width: 100%;
    min-width: 0;
  }

  .remelle-story__statement {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .remelle-story__body {
    margin-top: 32px;
    color: #241715;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 22px;
    letter-spacing: 0;
  }

  .remelle-story__body p {
    margin: 0;
  }

  .remelle-story__body p + p {
    margin-top: 22px;
  }

  .remelle-story__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    margin-top: 32px;
    padding: 0 20px;
    border: 1px solid var(--color-off-white);
    border-radius: var(--radius-none);
    background: var(--color-burgundy);
    color: var(--color-off-white);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.96px;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .remelle-story__button .icon-arrow-up-right {
    width: 24px;
    height: 24px;
  }

  .remelle-story__button:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.story",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "04 — Who we are"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Our story"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.editorial_image",
      "info": "t:labels.image_fallback_info"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.editorial_image_alt",
      "default": "Model in a black coat holding a Remelle shopping bag"
    },
    {
      "type": "text",
      "id": "statement",
      "label": "t:labels.statement",
      "default": "A brand shaped by intention"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.description",
      "default": "<p>Remelle was born from a desire to redefine luxury fashion with intention and authenticity. In a world saturated with fleeting trends, the founder envisioned a brand rooted in timeless elegance, meticulous craftsmanship and an unwavering commitment to quality.</p><p>Drawing from art, architecture and cultural heritage, each collection transcends seasons. Every garment is designed as a statement of modern sophistication, exceptional in feeling, exacting in finish and entirely individual.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.story"
    }
  ]
}
{% endschema %}
