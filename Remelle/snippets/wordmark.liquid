{% doc %}
  Remelle wordmark. The nav size is 128 by 24. The footer mark is the vector wordmark and displays at 469 wide.

  @param {string} variant - "nav" or "footer"
  @param {string} [class] - Extra class names

  @example
  {% render 'wordmark', variant: 'nav' %}
{% enddoc %}

{% liquid
  if variant == 'footer'
    assign wordmark_file = 'wordmark-beige.svg'
    assign wordmark_width = 470
    assign wordmark_height = 88
    assign wordmark_class = 'wordmark wordmark--footer'
  else
    assign wordmark_file = 'wordmark-burgundy.svg'
    assign wordmark_width = 128
    assign wordmark_height = 24
    assign wordmark_class = 'wordmark wordmark--nav'
  endif
%}

<img
  class="{{ wordmark_class }} {{ class }}"
  src="{{ wordmark_file | asset_url }}"
  alt=""
  width="{{ wordmark_width }}"
  height="{{ wordmark_height }}"
>
