{% doc %}
  Product card. The homepage carousel uses 363 by 550. The shop grid uses 323 by 497.

  @param {product} product - Product to render
  @param {string} [layout] - Pass shop for the listing grid card
  @param {boolean} [show_new_badge] - When false, the New in badge stays hidden
  @param {string} [badge_label] - New in badge text
  @param {string} [badge_tag] - Optional Admin tag that also shows New in
  @param {object} [new_products] - Theme-editor product list chosen to show New in
  @param {boolean} [show_sale_badge] - When false, the Sale badge stays hidden
  @param {string} [sale_label] - Sale badge text
  @param {string} [sale_tag] - Optional Admin tag that also shows Sale
  @param {object} [sale_products] - Theme-editor product list chosen to show Sale
  @param {boolean} [show_limited_badge] - When false, the Limited pieces badge stays hidden
  @param {string} [limited_label] - Limited pieces badge text
  @param {string} [limited_tag] - Optional product tag that also shows Limited pieces
  @param {object} [limited_products] - Theme-editor product list chosen to show Limited pieces
  @param {boolean} [show_low_stock_badge] - When false, the low-stock badge stays hidden
  @param {string} [low_stock_label] - Low-stock text; use __COUNT__ for remaining quantity
  @param {number} [low_stock_threshold] - Show when tracked inventory is below this (default 5)
  @param {object} [low_stock_products] - Theme-editor product list chosen to show low stock

  @example
  {% render 'remelle-product-card', product: product, show_new_badge: true, badge_label: 'New in', new_products: section.settings.new_products, show_sale_badge: true, sale_label: 'Sale', sale_products: section.settings.sale_products, show_limited_badge: true, limited_label: 'Limited pieces', limited_products: section.settings.limited_products, show_low_stock_badge: true, low_stock_label: 'Only __COUNT__ left', low_stock_threshold: 5, low_stock_products: section.settings.low_stock_products %}
{% enddoc %}

{%- liquid
  assign card_title = product.title
  assign card_url = product.url
  assign card_price = product.price
  assign card_image = product.featured_image
  assign card_alt = card_image.alt | default: product.title
  assign color_option = nil
  assign show_new = false
  assign show_sale = false
  assign show_limited = false
  assign show_preorder = false
  assign show_coming_soon = false
  assign show_low_stock = false
  assign stock_left = 0
  assign stock_tracked = false
  assign product_handle = product.handle

  assign new_label_text = badge_label | default: settings.badge_label | default: 'New in'
  assign sale_label_text = sale_label | default: settings.sale_label | default: 'Sale'
  assign limited_text = limited_label | default: settings.limited_label | default: 'Limited pieces'
  assign preorder_text = preorder_label | default: settings.preorder_label
  if preorder_text == blank
    assign preorder_text = 'products.preorder_badge' | t
  endif
  assign coming_soon_text = coming_soon_label | default: settings.coming_soon_label
  if coming_soon_text == blank
    assign coming_soon_text = 'products.coming_soon_badge' | t
  endif
  assign low_stock_text = low_stock_label | default: settings.low_stock_label | default: 'Only __COUNT__ left'
  assign new_tag_setting = badge_tag | default: settings.badge_tag | downcase | strip
  assign sale_tag_setting = sale_tag | default: settings.sale_tag | downcase | strip
  assign limited_tag_setting = limited_tag | default: settings.limited_tag | downcase | strip
  assign preorder_tag_setting = preorder_tag | default: settings.preorder_tag | downcase | strip
  assign coming_soon_tag_setting = coming_soon_tag | default: settings.coming_soon_tag | downcase | strip
  assign stock_threshold = low_stock_threshold | default: settings.low_stock_threshold | default: 5 | plus: 0
  if stock_threshold <= 0
    assign stock_threshold = 5
  endif

  assign new_list = new_products | default: settings.new_products
  assign sale_list = sale_products | default: settings.sale_products
  assign limited_list = limited_products | default: settings.limited_products
  assign preorder_section_list = preorder_products
  assign preorder_theme_list = settings.preorder_products
  assign coming_section_list = coming_soon_products
  assign coming_theme_list = settings.coming_soon_products
  assign low_stock_list = low_stock_products | default: settings.low_stock_products

  assign new_enabled = false
  if show_new_badge == true or settings.show_new_badge == true or new_list != blank
    assign new_enabled = true
  endif
  assign sale_enabled = false
  if show_sale_badge == true or settings.show_sale_badge == true or sale_list != blank
    assign sale_enabled = true
  endif
  assign limited_enabled = false
  if show_limited_badge == true or settings.show_limited_badge == true or limited_list != blank
    assign limited_enabled = true
  endif
  assign preorder_enabled = false
  if show_preorder_badge == true or settings.show_preorder_badge == true or preorder_section_list != blank or preorder_theme_list != blank
    assign preorder_enabled = true
  endif
  assign coming_enabled = false
  if show_coming_soon_badge == true or settings.show_coming_soon_badge == true or coming_section_list != blank or coming_theme_list != blank
    assign coming_enabled = true
  endif
  assign low_stock_enabled = false
  if show_low_stock_badge == true or settings.show_low_stock_badge == true or low_stock_list != blank
    assign low_stock_enabled = true
  endif

  if new_enabled and new_label_text != blank
    if new_list != blank
      for item in new_list
        if item.id == product.id or item.handle == product_handle or item == product_handle
          assign show_new = true
        endif
      endfor
    elsif new_tag_setting != blank
      assign new_terms = new_tag_setting | split: ','
      for tag in product.tags
        assign tag_value = tag | downcase | strip
        for term in new_terms
          assign term_value = term | strip
          if tag_value == term_value or term_value == 'new' and tag_value == 'new in'
            assign show_new = true
          endif
        endfor
      endfor
    endif
  endif

  if sale_enabled and sale_label_text != blank
    if sale_list != blank
      for item in sale_list
        if item.id == product.id or item.handle == product_handle or item == product_handle
          assign show_sale = true
        endif
      endfor
    elsif sale_tag_setting != blank
      assign sale_terms = sale_tag_setting | split: ','
      for tag in product.tags
        assign tag_value = tag | downcase | strip
        for term in sale_terms
          assign term_value = term | strip
          if tag_value == term_value
            assign show_sale = true
          endif
        endfor
      endfor
    endif
  endif

  if product.metafields.custom.limited_label != blank
    assign limited_text = product.metafields.custom.limited_label.value | default: product.metafields.custom.limited_label
  endif

  if limited_enabled and limited_text != blank
    if limited_list != blank
      for item in limited_list
        if item.id == product.id or item.handle == product_handle or item == product_handle
          assign show_limited = true
        endif
      endfor
    endif

    assign limited_metafield = product.metafields.custom.show_limited_pieces
    if show_limited == false and limited_metafield == true
      assign show_limited = true
    endif
    if show_limited == false and limited_metafield.value == true
      assign show_limited = true
    endif

    if show_limited == false and limited_tag_setting != blank
      for tag in product.tags
        assign tag_value = tag | downcase | strip
        if tag_value == limited_tag_setting
          assign show_limited = true
        endif
      endfor
    endif
  endif

  if preorder_enabled and preorder_text != blank
    if preorder_section_list != blank
      for item in preorder_section_list
        if item.id == product.id or item.handle == product_handle or item == product_handle
          assign show_preorder = true
        endif
      endfor
    endif
    if show_preorder == false and preorder_section_only != true and preorder_theme_list != blank
      for item in preorder_theme_list
        if item.id == product.id or item.handle == product_handle or item == product_handle
          assign show_preorder = true
        endif
      endfor
    endif
    if show_preorder == false and preorder_section_only != true and preorder_section_list == blank and preorder_theme_list == blank and preorder_tag_setting != blank
      for tag in product.tags
        assign tag_value = tag | downcase | strip
        if tag_value == preorder_tag_setting or tag_value == 'pre order' or tag_value == 'preorder'
          assign show_preorder = true
        endif
      endfor
    endif
  endif

  if coming_enabled and coming_soon_text != blank
    if coming_section_list != blank
      for item in coming_section_list
        if item.id == product.id or item.handle == product_handle or item == product_handle
          assign show_coming_soon = true
        endif
      endfor
    endif
    if show_coming_soon == false and coming_theme_list != blank
      for item in coming_theme_list
        if item.id == product.id or item.handle == product_handle or item == product_handle
          assign show_coming_soon = true
        endif
      endfor
    endif
    if show_coming_soon == false and coming_section_list == blank and coming_theme_list == blank and coming_soon_tag_setting != blank
      for tag in product.tags
        assign tag_value = tag | downcase | strip
        if tag_value == coming_soon_tag_setting or tag_value == 'coming-soon'
          assign show_coming_soon = true
        endif
      endfor
    endif
  endif

  for variant in product.variants
    if variant.inventory_management != blank
      assign stock_tracked = true
      if variant.inventory_quantity > 0
        assign stock_left = stock_left | plus: variant.inventory_quantity
      endif
    endif
  endfor

  if product.metafields.custom.low_stock_label != blank
    assign low_stock_text = product.metafields.custom.low_stock_label.value | default: product.metafields.custom.low_stock_label
  endif
  assign low_stock_text = low_stock_text | replace: '__COUNT__', stock_left | replace: '[count]', stock_left

  if low_stock_enabled and low_stock_text != blank and stock_tracked and stock_left > 0 and stock_left <= stock_threshold
    if low_stock_list != blank
      for item in low_stock_list
        if item.id == product.id or item.handle == product_handle or item == product_handle
          assign show_low_stock = true
        endif
      endfor
    else
      assign show_low_stock = true
    endif

    assign low_stock_metafield = product.metafields.custom.show_low_stock
    if show_low_stock == false and low_stock_metafield == true
      assign show_low_stock = true
    endif
    if show_low_stock == false and low_stock_metafield.value == true
      assign show_low_stock = true
    endif
  endif

  assign preorder_at_bottom = false
  if preorder_placement == 'bottom'
    assign preorder_at_bottom = true
  endif
  assign show_preorder_top = false
  if show_preorder and preorder_at_bottom == false
    assign show_preorder_top = true
  endif

  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'color' or option_name == 'colour'
      assign color_option = option
    endif
  endfor
-%}

<article class="remelle-card{% if layout == 'shop' %} remelle-card--shop{% endif %}">
  <div class="remelle-card__photo">
    <a class="remelle-card__media" href="{{ card_url }}">
      {%- if card_image != blank -%}
        {{
          card_image
          | image_url: width: 800, format: 'jpg' | image_tag:
            widths: '363, 726',
            sizes: '363px',
            alt: card_alt,
            class: 'remelle-card__image',
            loading: 'lazy'
        }}
      {%- endif -%}
    </a>

    {%- if show_new or show_sale or show_limited or show_preorder_top or show_coming_soon -%}
      <div class="remelle-card__badges">
        {%- if show_coming_soon -%}
          <p class="remelle-card__badge remelle-card__badge--coming">{{ coming_soon_text | escape }}</p>
        {%- endif -%}
        {%- if show_preorder_top -%}
          <p class="remelle-card__badge remelle-card__badge--preorder">{{ preorder_text | escape }}</p>
        {%- endif -%}
        {%- if show_limited -%}
          <p class="remelle-card__badge remelle-card__badge--limited">{{ limited_text | escape }}</p>
        {%- endif -%}
        {%- if show_new -%}
          <p class="remelle-card__badge">{{ new_label_text | escape }}</p>
        {%- endif -%}
        {%- if show_sale -%}
          <p class="remelle-card__badge remelle-card__badge--sale">{{ sale_label_text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_low_stock -%}
      <p class="remelle-card__stock">{{ low_stock_text | escape }}</p>
    {%- endif -%}

    {%- liquid
      assign quick_variant = product.selected_or_first_available_variant
      assign quick_available = false
      if quick_variant and quick_variant.available
        assign quick_available = true
      endif
    -%}
    {%- if product.has_only_default_variant and quick_variant -%}
      {% form 'product', product, class: 'remelle-card__form' %}
        <input type="hidden" name="id" value="{{ quick_variant.id }}">
        <button
          class="remelle-card__add"
          type="submit"
          {% if quick_available %}
            aria-label="{{ 'products.add' | t: title: card_title }}"
          {% else %}
            aria-label="{{ 'product.sold_out' | t }}"
            disabled
          {% endif %}
        >
          {% render 'icon-plus' %}
        </button>
      {% endform %}
    {%- elsif quick_variant -%}
      <a
        class="remelle-card__add remelle-card__add--link"
        href="{{ card_url }}"
        aria-label="{{ 'products.choose_options' | t: title: card_title }}"
      >
        {% render 'icon-plus' %}
      </a>
    {%- endif -%}
  </div>

  <h3 class="remelle-card__name">
    <a href="{{ card_url }}">{{ card_title | escape }}</a>
  </h3>

  <div class="remelle-card__meta">
    <p class="remelle-card__price">{{ card_price | money }}</p>
    {%- if color_option -%}
      <ul class="remelle-card__swatches">
        {%- for value in color_option.values limit: 2 -%}
          {%- liquid
            assign swatch_color = value.swatch.color
            if swatch_color == blank
              assign swatch_name = value.name | downcase
              case swatch_name
                when 'burgundy'
                  assign swatch_color = '#670D0D'
                when 'black'
                  assign swatch_color = '#060505'
                when 'off white', 'cream', 'ivory', 'white'
                  assign swatch_color = '#F3EDE4'
                when 'brown'
                  assign swatch_color = '#6A4A38'
                else
                  assign swatch_color = '#D0CBC4'
              endcase
            endif
          -%}
          <li class="remelle-card__swatch" style="background: {{ swatch_color }};">
            <span class="remelle-card__swatch-label">{{ value.name | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
      {%- if color_option.values.size > 2 -%}
        <p class="remelle-card__more">+ {{ color_option.values.size | minus: 2 }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
  {%- if show_preorder and preorder_at_bottom -%}
    <p class="remelle-card__preorder">{{ preorder_text | escape }}</p>
  {%- endif -%}
</article>

{% stylesheet %}
  .remelle-card {
    flex: 0 0 363px;
    width: 363px;
    color: #242424;
  }

  .remelle-card.remelle-card--shop {
    flex: none;
    width: 323px;
  }

  .remelle-card.remelle-card--shop .remelle-card__photo {
    height: 431px;
  }

  .remelle-products .remelle-card {
    flex: 0 0 calc((100% - 32px) / 3);
    width: calc((100% - 32px) / 3);
    max-width: none;
    scroll-snap-align: start;
  }

  .remelle-products .remelle-card__photo {
    height: auto;
    aspect-ratio: 363 / 484;
  }

  @media (max-width: 1024px) {
    .remelle-products .remelle-card {
      flex-basis: calc((100% - 16px) / 2);
      width: calc((100% - 16px) / 2);
    }
  }

  @media (max-width: 768px) {
    .remelle-card,
    .remelle-card.remelle-card--shop {
      flex: 1 1 calc(50% - 8px);
      width: calc(50% - 8px);
      max-width: 323px;
    }

    .remelle-products .remelle-card {
      flex: 0 0 100%;
      width: 100%;
      max-width: none;
    }

    .remelle-recs .remelle-card {
      flex: 0 0 calc(100vw - (var(--page-inset) * 2) - 20px);
      width: calc(100vw - (var(--page-inset) * 2) - 20px);
      max-width: none;
    }

    .remelle-card__photo,
    .remelle-card.remelle-card--shop .remelle-card__photo {
      height: auto;
      aspect-ratio: 323 / 431;
    }
  }

  @media (max-width: 600px) {
    .remelle-listing .remelle-card,
    .remelle-listing .remelle-card.remelle-card--shop {
      flex: 1 1 100%;
      width: 100%;
      max-width: none;
    }
  }

  .remelle-card__photo {
    position: relative;
    height: 484px;
    overflow: hidden;
    background: var(--color-beige);
  }

  .remelle-card__media {
    display: block;
    height: 100%;
    padding: 10px;
  }

  .remelle-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.7s ease;
  }

  @media (hover: hover) {
    .remelle-card:hover .remelle-card__image {
      transform: scale(1.045);
    }
  }

  .remelle-card__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    z-index: 1;
  }

  .remelle-card__badge {
    margin: 0;
    padding: 2px 6px;
    border-radius: var(--radius-badge);
    background: #ffffff;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    line-height: 12px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .remelle-card__badge--sale {
    background: var(--color-burgundy);
    color: var(--color-off-white);
  }

  .remelle-card__badge--limited,
  .remelle-card__badge--preorder,
  .remelle-card__badge--coming {
    background: #ffffff;
    color: #670d0d;
  }

  .remelle-card__preorder {
    margin: 10px 0 0;
    color: #670d0d;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    line-height: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .remelle-card__stock {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 1;
    margin: 0;
    max-width: calc(100% - 70px);
    padding: 2px 6px;
    border-radius: var(--radius-badge);
    background: #ffffff;
    color: #670d0d;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    line-height: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .remelle-card__form {
    margin: 0;
  }

  .remelle-card__add {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--color-burgundy);
    color: var(--color-off-white);
    cursor: pointer;
  }

  .remelle-card__add:disabled {
    opacity: 0.35;
    cursor: default;
  }

  a.remelle-card__add--link {
    text-decoration: none;
  }

  .remelle-card__add:focus-visible,
  .remelle-card__name a:focus-visible,
  .remelle-card__media:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  .remelle-card__name {
    margin: 20px 0 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .remelle-card__name a {
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .remelle-card__meta {
    display: flex;
    align-items: center;
    height: 17px;
    margin-top: 12px;
  }

  .remelle-card__price {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    line-height: 17px;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .remelle-card__swatches {
    display: flex;
    margin: 0 0 0 17px;
    padding: 0;
    list-style: none;
  }

  .remelle-card__swatch {
    position: relative;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-swatch);
  }

  .remelle-card__swatch + .remelle-card__swatch {
    margin-left: -4px;
  }

  .remelle-card__swatch-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .remelle-card__more {
    margin: 0 0 0 4px;
    color: #242424;
    font-family: Inter, var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: nowrap;
  }
{% endstylesheet %}
