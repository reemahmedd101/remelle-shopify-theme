<section class="remelle-page" aria-labelledby="RemellePage-{{ section.id }}">
  <div class="remelle-page__inner">
    {%- if section.settings.show_title -%}
      <h1 class="remelle-page__heading" id="RemellePage-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading | escape }}
        {%- else -%}
          {{ page.title | escape }}
        {%- endif -%}
      </h1>
    {%- endif -%}

    {%- if section.settings.content != blank -%}
      <div class="remelle-page__content">{{ section.settings.content }}</div>
    {%- elsif page.content != blank -%}
      <div class="remelle-page__content">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .remelle-page {
    padding: 80px var(--page-inset) 120px;
  }

  .remelle-page__inner {
    width: min(720px, 100%);
    margin-inline: auto;
  }

  .remelle-page__heading {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .remelle-page__content {
    margin-top: 32px;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 22px;
  }

  .remelle-page__content p {
    margin: 0;
  }

  .remelle-page__content p + p {
    margin-top: 22px;
  }

  .remelle-page__content img,
  .remelle-page__content table,
  .remelle-page__content iframe {
    max-width: 100%;
  }

  @media (max-width: 768px) {
    .remelle-page {
      padding-block: 48px 80px;
    }

    .remelle-page__heading {
      font-size: 40px;
      line-height: 1.05;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:labels.show_title",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.page_heading_info"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:labels.description",
      "info": "t:labels.page_content_info"
    }
  ],
  "presets": [
    {
      "name": "t:general.page"
    }
  ]
}
{% endschema %}
