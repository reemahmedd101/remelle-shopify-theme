{%- liquid
  assign page_eyebrow = section.settings.eyebrow
  if page_eyebrow == blank
    assign page_eyebrow = 'cart.eyebrow' | t
  endif
  assign page_heading = section.settings.heading
  if page_heading == blank
    assign page_heading = 'cart.title' | t
  endif
  assign continue_label = section.settings.continue_label
  if continue_label == blank
    assign continue_label = 'cart.continue_shopping' | t
  endif
  assign checkout_label = section.settings.checkout_label
  if checkout_label == blank
    assign checkout_label = 'cart.checkout' | t
  endif
  assign update_label = section.settings.update_label
  if update_label == blank
    assign update_label = 'cart.update' | t
  endif
  assign empty_heading = section.settings.empty_heading
  if empty_heading == blank
    assign empty_heading = 'cart.empty_title' | t
  endif
  assign empty_body = section.settings.empty_body
  if empty_body == blank
    assign empty_body = 'cart.empty_body' | t
  endif
  assign empty_recs_heading = section.settings.empty_recs_heading
  if empty_recs_heading == blank
    assign empty_recs_heading = 'cart.empty_recs_heading' | t
  endif
  assign empty_recs_body = section.settings.empty_recs_body
  if empty_recs_body == blank
    assign empty_recs_body = 'cart.empty_recs_body' | t
  endif
  assign summary_heading = section.settings.summary_heading
  if summary_heading == blank
    assign summary_heading = 'cart.order_summary' | t
  endif
  assign cart_form_id = 'RemelleCartForm-' | append: section.id
  assign empty_rec_limit = 4
  assign empty_rec_count = 0
  assign empty_rec_source = section.settings.empty_products
  if empty_rec_source == blank or empty_rec_source.size == 0
    assign empty_rec_source = collections.all.products
  endif

  assign offer_mode = section.settings.offer_mode | default: 'quantity'
  assign offer_qty_threshold = section.settings.offer_item_target | default: 3 | plus: 0
  if offer_qty_threshold < 1
    assign offer_qty_threshold = 1
  endif
  assign offer_amount_threshold = section.settings.free_shipping_threshold | default: 3000 | plus: 0
  if offer_amount_threshold < 0
    assign offer_amount_threshold = 0
  endif

  assign offer_unlocked = false
  assign offer_progress = 0
  assign offer_remaining_count = 0
  assign offer_remaining_money = ''
  assign offer_progress_msg = ''
  assign offer_progress_before = ''
  assign offer_progress_after = ''
  assign offer_highlight = ''
  assign offer_kicker = section.settings.offer_progress_kicker
  if offer_kicker == blank
    assign offer_kicker = 'cart.offer_progress_kicker' | t
  endif
  assign offer_success_kicker = section.settings.offer_success_kicker
  if offer_success_kicker == blank
    assign offer_success_kicker = 'cart.offer_success_kicker' | t
  endif
  assign offer_success_msg = section.settings.free_shipping_success
  assign offer_success_legacy = "Yay — you've unlocked your offer"
  if offer_success_msg == blank or offer_success_msg == offer_success_legacy
    assign offer_success_msg = 'cart.free_shipping_success' | t
  endif

  if offer_mode == 'quantity'
    assign offer_remaining_count = offer_qty_threshold | minus: cart.item_count
    if offer_remaining_count < 0
      assign offer_remaining_count = 0
    endif
    if offer_qty_threshold > 0
      assign offer_progress = cart.item_count | times: 100 | divided_by: offer_qty_threshold
      if offer_progress > 100
        assign offer_progress = 100
      endif
    else
      assign offer_progress = 100
    endif
    if offer_remaining_count == 0
      assign offer_unlocked = true
    endif
    assign offer_unit = 'cart.offer_unit_other' | t
    if offer_remaining_count == 1
      assign offer_unit = 'cart.offer_unit_one' | t
    endif
    assign offer_highlight = offer_remaining_count | append: ' ' | append: offer_unit
    assign offer_progress_template = section.settings.offer_quantity_progress
    if offer_progress_template == blank or offer_progress_template == 'Add __COUNT__ more items to unlock your offer'
      assign offer_progress_template = 'cart.offer_quantity_progress' | t
    endif
    assign offer_progress_msg = offer_progress_template
    if offer_progress_msg contains '__HIGHLIGHT__'
      assign offer_progress_parts = offer_progress_msg | split: '__HIGHLIGHT__'
      assign offer_progress_before = offer_progress_parts[0]
      assign offer_progress_after = offer_progress_parts[1]
    else
      assign offer_progress_msg = offer_progress_msg | replace: '__COUNT__', offer_remaining_count | replace: '__UNIT__', offer_unit
    endif
  else
    assign offer_amount_cents = offer_amount_threshold | times: 100
    assign offer_remaining_cents = offer_amount_cents | minus: cart.total_price
    if offer_remaining_cents < 0
      assign offer_remaining_cents = 0
    endif
    assign offer_remaining_money = offer_remaining_cents | money
    if offer_amount_cents > 0
      assign offer_progress = cart.total_price | times: 100 | divided_by: offer_amount_cents
      if offer_progress > 100
        assign offer_progress = 100
      endif
    else
      assign offer_progress = 100
    endif
    if offer_remaining_cents == 0
      assign offer_unlocked = true
    endif
    assign offer_progress_msg = section.settings.free_shipping_progress
    if offer_progress_msg == blank
      assign offer_progress_msg = 'cart.free_shipping_progress' | t
    endif
    assign offer_progress_msg = offer_progress_msg | replace: '__AMOUNT__', offer_remaining_money
  endif

  assign show_offer_bar = false
  if section.settings.show_free_shipping_bar and cart.item_count > 0
    if offer_mode == 'quantity' and offer_qty_threshold > 0
      assign show_offer_bar = true
    elsif offer_mode != 'quantity' and offer_amount_threshold > 0
      assign show_offer_bar = true
    endif
  endif

  if offer_mode == 'quantity'
    assign offer_goal_value = offer_qty_threshold
  else
    assign offer_goal_value = offer_amount_threshold
  endif
  if offer_mode == 'quantity'
    assign offer_template_attr = offer_progress_template
  else
    assign offer_template_attr = offer_progress_msg
  endif
  assign offer_unit_one_label = 'cart.offer_unit_one' | t
  assign offer_unit_other_label = 'cart.offer_unit_other' | t
-%}

<section
  class="remelle-cart"
  aria-labelledby="RemelleCartTitle-{{ section.id }}"
  data-remove-confirm="{{ 'cart.remove_confirm' | t | escape }}"
>
  <div class="remelle-cart__inner{% if cart.item_count == 0 %} remelle-cart__inner--empty{% endif %}">
    {%- if cart.item_count > 0 -%}
      <header class="remelle-cart__header">
        {%- if page_eyebrow != blank -%}
          <p class="remelle-cart__eyebrow">{{ page_eyebrow | escape }}</p>
        {%- endif -%}
        <div class="remelle-cart__heading-row">
          <h1 class="remelle-cart__title" id="RemelleCartTitle-{{ section.id }}">
            {{ page_heading | escape }}
          </h1>
          <p class="remelle-cart__count" data-cart-page-count data-item-count="{{ cart.item_count }}">{{ 'cart.item_count' | t: count: cart.item_count }}</p>
        </div>
      </header>
    {%- endif -%}

    {%- if cart.item_count == 0 -%}
      <div class="remelle-cart__empty remelle-cart-empty" data-empty-cart>
        <div class="remelle-cart-empty__hero">
          {%- if page_eyebrow != blank -%}
            <p class="remelle-cart-empty__kicker">{{ page_eyebrow | escape }}</p>
          {%- endif -%}
          <h1 class="remelle-cart__empty-title" id="RemelleCartTitle-{{ section.id }}">
            {{ empty_heading | escape }}
          </h1>
          <span class="remelle-cart-empty__rule" aria-hidden="true"></span>
          {%- if empty_body != blank -%}
            <p class="remelle-cart__empty-body">{{ empty_body | escape }}</p>
          {%- endif -%}
          <a class="remelle-cart__cta remelle-cart-empty__cta" href="{{ routes.all_products_collection_url }}">
            {{ continue_label | escape }}
          </a>
        </div>

        <div class="remelle-cart-empty__recs">
          <header class="remelle-cart-empty__intro">
            {%- if empty_recs_heading != blank -%}
              <p class="remelle-cart-empty__eyebrow">{{ empty_recs_heading | escape }}</p>
            {%- endif -%}
            {%- if empty_recs_body != blank -%}
              <h2 class="remelle-cart-empty__lede">{{ empty_recs_body | escape }}</h2>
            {%- endif -%}
          </header>

          <div class="remelle-cart-empty__grid">
            {%- for product in empty_rec_source -%}
              {%- if empty_rec_count >= empty_rec_limit -%}
                {%- break -%}
              {%- endif -%}
              {%- if product.available == false -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign empty_rec_count = empty_rec_count | plus: 1 -%}
              <div class="remelle-cart-empty__item">
                {% render 'remelle-product-card', product: product %}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- else -%}
      {% form 'cart', cart, class: 'remelle-cart__form', id: cart_form_id %}
        {%- if form.errors -%}
          <div class="remelle-cart__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="remelle-cart__main">
          <div class="remelle-cart__columns" aria-hidden="true">
            <span>{{ 'cart.product' | t }}</span>
            <span>{{ 'cart.quantity' | t }}</span>
            <span>{{ 'cart.total' | t }}</span>
          </div>

          <ul class="remelle-cart__lines" role="list">
            {%- for item in cart.items -%}
              {%- assign line_id = 'RemelleCartQty-' | append: section.id | append: '-' | append: forloop.index -%}
              <li class="remelle-cart__line" data-cart-line data-line-key="{{ item.key | escape }}">
                <div class="remelle-cart__product">
                  <a class="remelle-cart__media" href="{{ item.url }}">
                    {%- if item.image -%}
                      {{
                        item.image
                        | image_url: width: 480, format: 'jpg' | image_tag:
                          widths: '160, 320, 480',
                          sizes: '(max-width: 768px) 96px, 160px',
                          alt: item.image.alt | default: item.product.title,
                          class: 'remelle-cart__image',
                          loading: 'lazy'
                      }}
                    {%- else -%}
                      <span class="remelle-cart__image remelle-cart__image--placeholder" aria-hidden="true"></span>
                    {%- endif -%}
                  </a>

                  <div class="remelle-cart__meta">
                    <a class="remelle-cart__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>

                    {%- unless item.product.has_only_default_variant -%}
                      <p class="remelle-cart__variant">{{ item.variant.title | escape }}</p>
                    {%- endunless -%}

                    {%- if item.selling_plan_allocation -%}
                      <p class="remelle-cart__variant">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                    {%- endif -%}

                    {%- for property in item.properties -%}
                      {%- assign property_first = property.first -%}
                      {%- if property.last != blank and property_first.first != '_' -%}
                        <p class="remelle-cart__variant">
                          {{ property_first | escape }}: {{ property.last | escape }}
                        </p>
                      {%- endif -%}
                    {%- endfor -%}

                    <p class="remelle-cart__unit-price">
                      {%- if item.original_price != item.final_price -%}
                        <s>{{ item.original_price | money }}</s>
                      {%- endif -%}
                      <span data-line-unit-price data-unit-cents="{{ item.final_price }}">{{ item.final_price | money }}</span>
                    </p>

                    <a class="remelle-cart__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                  </div>
                </div>

                <div class="remelle-cart__qty">
                  <label class="visually-hidden" for="{{ line_id }}">
                    {{ 'cart.quantity' | t }}
                  </label>
                  <div class="remelle-cart__qty-controls">
                    <button
                      class="remelle-cart__qty-btn remelle-cart__qty-btn--minus"
                      type="button"
                      data-cart-qty="-1"
                      aria-label="{{ 'product.decrease' | t }}"
                    >
                      {% render 'icon-minus' %}
                    </button>
                    <input
                      class="remelle-cart__qty-input"
                      id="{{ line_id }}"
                      type="number"
                      name="updates[{{ item.key }}]"
                      value="{{ item.quantity }}"
                      min="0"
                      inputmode="numeric"
                      data-cart-qty-input
                      data-line-key="{{ item.key | escape }}"
                      {% if item.variant.inventory_management != blank and item.variant.inventory_policy == 'deny' and item.variant.inventory_quantity > 0 %}
                        max="{{ item.variant.inventory_quantity }}"
                      {% endif %}
                    >
                    <button
                      class="remelle-cart__qty-btn remelle-cart__qty-btn--plus"
                      type="button"
                      data-cart-qty="1"
                      aria-label="{{ 'product.increase' | t }}"
                    >
                      {% render 'icon-plus' %}
                    </button>
                  </div>
                </div>

                <div class="remelle-cart__prices">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s class="remelle-cart__compare">{{ item.original_line_price | money }}</s>
                  {%- endif -%}
                  <p class="remelle-cart__line-price" data-line-price data-line-cents="{{ item.final_line_price }}">{{ item.final_line_price | money }}</p>
                </div>
              </li>
            {%- endfor -%}
          </ul>

          <div class="remelle-cart__toolbar">
            <a class="remelle-cart__continue" href="{{ routes.all_products_collection_url }}">
              {{ continue_label | escape }}
            </a>
            <button class="remelle-cart__update" type="submit" name="update">
              {{ update_label | escape }}
            </button>
          </div>
        </div>

        <aside class="remelle-cart__aside" aria-labelledby="RemelleCartSummary-{{ section.id }}">
          <h2 class="remelle-cart__summary-title" id="RemelleCartSummary-{{ section.id }}">
            {{ summary_heading | escape }}
          </h2>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="remelle-cart__discounts" role="list">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="remelle-cart__discount">
                  <span>{{ discount.title | escape }}</span>
                  <span>-{{ discount.total_allocated_amount | money }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="remelle-cart__discount-form">
            <label class="remelle-cart__discount-label" for="RemelleCartDiscount-{{ section.id }}">
              {{ 'cart.discount_code' | t }}
            </label>
            <div class="remelle-cart__discount-row">
              <input
                class="remelle-cart__discount-input"
                id="RemelleCartDiscount-{{ section.id }}"
                type="text"
                value=""
                autocomplete="off"
                placeholder="{{ 'cart.discount_placeholder' | t | escape }}"
                data-cart-discount
                aria-describedby="RemelleCartDiscountHint-{{ section.id }}"
              >
              <button class="remelle-cart__discount-apply" type="button" data-cart-discount-apply>
                {{ 'cart.apply' | t }}
              </button>
            </div>
            <p class="remelle-cart__discount-hint" id="RemelleCartDiscountHint-{{ section.id }}">
              {{ 'cart.discount_hint' | t }}
            </p>
          </div>

          {%- if show_offer_bar -%}
            {% render 'remelle-cart-offer',
              variant: 'aside',
              unlocked: offer_unlocked,
              progress: offer_progress,
              kicker: offer_kicker,
              success_kicker: offer_success_kicker,
              success_msg: offer_success_msg,
              progress_before: offer_progress_before,
              progress_after: offer_progress_after,
              progress_msg: offer_progress_msg,
              highlight: offer_highlight,
              mode: offer_mode,
              goal: offer_goal_value,
              progress_kicker_attr: offer_kicker,
              success_kicker_attr: offer_success_kicker,
              success_attr: offer_success_msg,
              progress_template_attr: offer_template_attr,
              unit_one: offer_unit_one_label,
              unit_other: offer_unit_other_label
            %}
          {%- endif -%}

          <div class="remelle-cart__summary">
            <div class="remelle-cart__subtotal">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span data-cart-subtotal data-subtotal-cents="{{ cart.total_price }}">{{ cart.total_price | money }}</span>
            </div>
            <p class="remelle-cart__taxes">{{ 'cart.taxes_shipping' | t }}</p>
          </div>

          <button class="remelle-cart__checkout" type="submit" name="checkout">
            {{ checkout_label | escape }}
          </button>

          {%- if additional_checkout_buttons -%}
            <div class="remelle-cart__accelerated">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}
        </aside>
      {% endform %}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .remelle-cart {
    padding: 48px 0 140px;
    background: var(--color-off-white);
  }

  .remelle-cart {
    transition: opacity 0.35s ease;
  }

  .remelle-cart.is-refreshing,
  .remelle-cart.is-entering {
    opacity: 0.28;
  }

  .remelle-cart__inner {
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .remelle-cart__header {
    margin-bottom: 24px;
  }

  .remelle-cart__eyebrow {
    margin: 0 0 16px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 15px;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-cart__heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }

  .remelle-cart__title {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .remelle-cart__count {
    margin: 0;
    color: #8a8178;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
  }

  .remelle-cart__inner--empty {
    padding-top: 24px;
  }

  .remelle-cart__empty,
  .remelle-cart-empty {
    display: grid;
    gap: 80px;
    max-width: none;
    padding: 0 0 72px;
  }

  .remelle-cart-empty__hero {
    display: grid;
    justify-items: center;
    gap: 0;
    max-width: 520px;
    margin: 28px auto 0;
    text-align: center;
  }

  .remelle-cart-empty__kicker {
    margin: 0 0 18px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-cart__empty-title {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: clamp(40px, 6vw, 56px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .remelle-cart-empty__rule {
    display: block;
    width: 40px;
    height: 1px;
    margin: 22px 0 0;
    background: var(--color-burgundy);
    opacity: 0.45;
  }

  .remelle-cart__empty-body {
    max-width: 32ch;
    margin: 18px 0 0;
    color: #060505;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
  }

  .remelle-cart-empty__cta {
    margin-top: 28px;
    border-color: var(--color-burgundy);
  }

  .remelle-cart-empty__recs {
    display: grid;
    gap: 28px;
    padding-top: 8px;
    border-top: 1px solid rgba(103, 13, 13, 0.12);
  }

  .remelle-cart-empty__intro {
    display: grid;
    gap: 10px;
  }

  .remelle-cart-empty__eyebrow {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-cart-empty__lede {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .remelle-cart-empty__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 16px;
  }

  .remelle-cart-empty__item .remelle-card {
    flex: none;
    width: 100%;
    max-width: none;
  }

  .remelle-cart-empty__item .remelle-card__photo {
    height: auto;
    aspect-ratio: 363 / 484;
  }

  @media (max-width: 1024px) {
    .remelle-cart-empty__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 16px;
    }
  }

  @media (max-width: 768px) {
    .remelle-cart__empty,
    .remelle-cart-empty {
      gap: 56px;
      padding-bottom: 48px;
    }

    .remelle-cart-empty__hero {
      margin-top: 12px;
    }
  }

  @media (max-width: 600px) {
    .remelle-cart-empty__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .remelle-cart__cta,
  .remelle-cart__checkout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 24px;
    border: 1px solid var(--color-off-white);
    background: var(--color-burgundy);
    color: var(--color-off-white);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.96px;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .remelle-cart__errors {
    grid-column: 1 / -1;
    margin: 0 0 8px;
    padding: 14px 16px;
    border: 1px solid var(--color-burgundy);
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.4;
  }

  .remelle-cart__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 64px;
    align-items: start;
  }

  .remelle-cart__columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 169px 120px;
    gap: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(36, 36, 36, 0.16);
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-cart__columns span:nth-child(2),
  .remelle-cart__columns span:nth-child(3) {
    text-align: center;
  }

  .remelle-cart__columns span:nth-child(3) {
    text-align: right;
  }

  .remelle-cart__lines {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .remelle-cart__line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 169px 120px;
    gap: 24px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid rgba(36, 36, 36, 0.16);
  }

  .remelle-cart__product {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    min-width: 0;
  }

  .remelle-cart__media {
    display: block;
    width: 160px;
    aspect-ratio: 160 / 214;
    background: var(--color-beige);
    overflow: hidden;
  }

  .remelle-cart__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10px;
  }

  .remelle-cart__image--placeholder {
    display: block;
    padding: 0;
    background: var(--color-beige);
  }

  .remelle-cart__name {
    display: block;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
    text-decoration: none;
  }

  .remelle-cart__variant {
    margin: 8px 0 0;
    color: #8a8178;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.3;
  }

  .remelle-cart__unit-price {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 0;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }

  .remelle-cart__unit-price s {
    color: #8a8178;
    font-weight: 400;
  }

  .remelle-cart__remove {
    display: inline-block;
    margin-top: 16px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.44px;
    text-decoration: underline;
    text-transform: uppercase;
  }

  .remelle-cart__qty {
    display: flex;
    justify-content: center;
  }

  .remelle-cart__qty-controls {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .remelle-cart__qty-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    cursor: pointer;
  }

  .remelle-cart__qty-btn--minus {
    background: #eadcd6;
    color: #242424;
  }

  .remelle-cart__qty-btn--plus {
    background: var(--color-burgundy);
    color: var(--color-off-white);
  }

  .remelle-cart__qty-input {
    width: 81px;
    height: 40px;
    padding: 0;
    border: 0;
    background: #ffffff;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 40px;
    text-align: center;
  }

  .remelle-cart__qty-input::-webkit-outer-spin-button,
  .remelle-cart__qty-input::-webkit-inner-spin-button {
    margin: 0;
    appearance: none;
  }

  .remelle-cart__prices {
    text-align: right;
  }

  .remelle-cart__compare {
    display: block;
    margin-bottom: 4px;
    color: #8a8178;
    font-family: var(--font-sans);
    font-size: 13px;
  }

  .remelle-cart__line-price {
    margin: 0;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
  }

  .remelle-cart__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 28px;
  }

  .remelle-cart__continue {
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.44px;
    text-decoration: underline;
    text-transform: uppercase;
  }

  .remelle-cart__update {
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--color-burgundy);
    background: transparent;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.96px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .remelle-cart__aside {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    padding: 32px 28px;
    background: var(--color-beige);
  }

  .remelle-cart__summary-title {
    margin: 0 0 24px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }

  .remelle-cart__discounts {
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
  }

  .remelle-cart__discount {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 14px;
  }

  .remelle-cart__discount-label {
    display: block;
    margin-bottom: 10px;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .remelle-cart__discount-row {
    display: flex;
    gap: 8px;
  }

  .remelle-cart__discount-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 44px;
    padding: 0 12px;
    border: 0;
    border-bottom: 1px solid rgba(36, 36, 36, 0.28);
    background: transparent;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 14px;
  }

  .remelle-cart__discount-input::placeholder {
    color: #8a8178;
  }

  .remelle-cart__discount-apply {
    flex: 0 0 auto;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--color-burgundy);
    background: transparent;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .remelle-cart__discount-hint {
    margin: 10px 0 0;
    color: #8a8178;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.4;
  }

  .remelle-cart__shipping {
    margin-top: 20px;
    padding: 14px 16px;
    border: 1px solid rgba(103, 13, 13, 0.12);
    background: linear-gradient(180deg, #faf5f0 0%, #f5ede3 100%);
    color: #670d0d;
    animation: remelle-girl-math-in 0.45s ease;
  }

  .remelle-cart__shipping.is-unlock-pulse {
    animation: remelle-girl-math-unlock 0.55s ease;
  }

  .remelle-cart__shipping-copy {
    margin: 0 0 10px;
  }

  .remelle-cart__shipping-kicker {
    margin: 0 0 6px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-cart__shipping--unlocked .remelle-cart__shipping-kicker {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-cart__shipping-text {
    margin: 0;
    color: #670d0d;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.45;
  }

  .remelle-cart__shipping-count {
    font-weight: 600;
  }

  .remelle-cart__shipping-track {
    height: 2px;
    overflow: hidden;
    background: rgba(103, 13, 13, 0.14);
  }

  .remelle-cart__shipping-fill {
    display: block;
    height: 100%;
    background: #670d0d;
    transition: width 0.45s ease;
  }

  @keyframes remelle-girl-math-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes remelle-girl-math-unlock {
    0% {
      transform: translateY(0);
      box-shadow: 0 0 0 0 rgba(103, 13, 13, 0);
    }
    40% {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(103, 13, 13, 0.12);
    }
    100% {
      transform: translateY(0);
      box-shadow: 0 0 0 0 rgba(103, 13, 13, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .remelle-cart__shipping,
    .remelle-cart__shipping.is-unlock-pulse {
      animation: none;
    }

    .remelle-cart__shipping-fill {
      transition: none;
    }
  }

  .remelle-cart__summary {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid rgba(36, 36, 36, 0.16);
  }

  .remelle-cart__subtotal {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
  }

  .remelle-cart__taxes {
    margin: 10px 0 0;
    color: #8a8178;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.4;
  }

  .remelle-cart__checkout {
    width: 100%;
    margin-top: 28px;
  }

  .remelle-cart__accelerated {
    margin-top: 16px;
  }

  .remelle-cart a:focus-visible,
  .remelle-cart button:focus-visible,
  .remelle-cart input:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .remelle-cart__form {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 40px;
    }

    .remelle-cart__columns,
    .remelle-cart__line {
      grid-template-columns: minmax(0, 1fr) 169px 96px;
    }
  }

  @media (max-width: 900px) {
    .remelle-cart__form {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .remelle-cart__aside {
      position: static;
    }

    .remelle-cart__columns {
      display: none;
    }

    .remelle-cart__line {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .remelle-cart__qty,
    .remelle-cart__prices {
      justify-content: flex-start;
      text-align: left;
    }
  }

  @media (max-width: 768px) {
    .remelle-cart {
      padding: 32px 0 96px;
    }

    .remelle-cart__title {
      font-size: 40px;
      line-height: 1;
    }

    .remelle-cart__heading-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .remelle-cart__product {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 16px;
    }

    .remelle-cart__media {
      width: 96px;
    }

    .remelle-cart__image {
      padding: 6px;
    }

    .remelle-cart__toolbar {
      flex-direction: column;
      align-items: stretch;
    }

    .remelle-cart__update {
      width: 100%;
    }
  }

  @media (max-width: 414px) {
    .remelle-cart__discount-row {
      flex-direction: column;
    }

    .remelle-cart__discount-apply {
      width: 100%;
    }

    .remelle-cart__qty-input {
      width: 64px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Shopping bag"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "t:labels.summary_heading",
      "default": "Order summary"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "t:labels.empty_heading",
      "default": "Your cart is empty."
    },
    {
      "type": "textarea",
      "id": "empty_body",
      "label": "t:labels.empty_body",
      "default": "Well, this is your sign to find something you love. ♡"
    },
    {
      "type": "text",
      "id": "empty_recs_heading",
      "label": "t:labels.empty_recs_heading",
      "default": "A little something for you"
    },
    {
      "type": "text",
      "id": "empty_recs_body",
      "label": "t:labels.empty_recs_body",
      "default": "Some pieces you might fall for."
    },
    {
      "type": "product_list",
      "id": "empty_products",
      "label": "t:labels.empty_products",
      "info": "t:labels.empty_products_info",
      "limit": 8
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "t:labels.continue_shopping",
      "default": "Continue shopping"
    },
    {
      "type": "text",
      "id": "update_label",
      "label": "t:labels.update_cart",
      "default": "Update cart"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "t:labels.checkout",
      "default": "Checkout"
    },
    {
      "type": "header",
      "content": "t:labels.free_shipping_header"
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping_bar",
      "label": "t:labels.show_free_shipping_bar",
      "info": "t:labels.show_free_shipping_bar_info",
      "default": true
    },
    {
      "type": "select",
      "id": "offer_mode",
      "label": "t:labels.offer_mode",
      "info": "t:labels.offer_mode_info",
      "options": [
        {
          "value": "quantity",
          "label": "t:labels.offer_mode_quantity"
        },
        {
          "value": "amount",
          "label": "t:labels.offer_mode_amount"
        }
      ],
      "default": "quantity"
    },
    {
      "type": "number",
      "id": "offer_item_target",
      "label": "t:labels.offer_quantity_threshold",
      "info": "t:labels.offer_quantity_threshold_info",
      "default": 3
    },
    {
      "type": "text",
      "id": "offer_progress_kicker",
      "label": "t:labels.offer_progress_kicker",
      "default": "💌 Girl math check"
    },
    {
      "type": "text",
      "id": "offer_quantity_progress",
      "label": "t:labels.offer_quantity_progress",
      "info": "t:labels.offer_quantity_progress_info",
      "default": "You're just __HIGHLIGHT__ away from FREE DELIVERY. Adding more is basically saving! 🎀"
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "t:labels.free_shipping_threshold",
      "info": "t:labels.free_shipping_threshold_info",
      "default": 3000
    },
    {
      "type": "text",
      "id": "free_shipping_progress",
      "label": "t:labels.free_shipping_progress",
      "info": "t:labels.free_shipping_progress_info",
      "default": "Add __AMOUNT__ more for free shipping"
    },
    {
      "type": "text",
      "id": "offer_success_kicker",
      "label": "t:labels.offer_success_kicker",
      "default": "Girl, you did the math! 💅"
    },
    {
      "type": "text",
      "id": "free_shipping_success",
      "label": "t:labels.free_shipping_success",
      "info": "t:labels.free_shipping_success_info",
      "default": "You've unlocked FREE DELIVERY. Happy shopping! ♡"
    }
  ],
  "presets": [
    {
      "name": "t:general.cart"
    }
  ]
}
{% endschema %}
