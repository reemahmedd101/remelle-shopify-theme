{% doc %}
  Shared styles for the announcement bar, navigation, and footer.

  @example
  {% render 'chrome-styles' %}
{% enddoc %}

{% stylesheet %}
  main {
    flex: 1 0 auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-to-content:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    width: auto;
    height: auto;
    margin: 0;
    padding: 12px 16px;
    overflow: visible;
    clip: auto;
    background: var(--color-burgundy);
    color: var(--color-off-white);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: normal;
  }

  /* Announcement + nav are sibling section wrappers — stack sticky offsets. */
  .shopify-section-group-header-group:has(.announcement) {
    position: sticky;
    top: 0;
    z-index: 41;
    background: var(--color-burgundy);
  }

  .shopify-section-group-header-group:has(.site-header) {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-beige);
  }

  body:has(.announcement) .shopify-section-group-header-group:has(.site-header) {
    top: var(--header-announcement-height);
  }

  .announcement {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--header-announcement-height);
    background: var(--color-burgundy);
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    line-height: 12px;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
  }

  .site-header {
    background: var(--color-beige);
    color: var(--color-burgundy);
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-nav-height);
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .site-header__group {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .site-header__group--end {
    justify-content: flex-end;
  }

  .site-nav-link {
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .wordmark {
    display: block;
    object-fit: contain;
  }

  .wordmark--nav {
    width: 128px;
    height: 24px;
  }

  .wordmark--footer {
    width: 469px;
    height: auto;
    margin-inline: auto;
  }

  .site-header a:focus-visible,
  .site-footer a:focus-visible,
  .site-footer button:focus-visible,
  .site-footer input:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 2px;
  }

  .site-footer {
    background: var(--color-burgundy);
    color: var(--color-beige);
    padding-top: 80px;
    padding-bottom: 48px;
  }

  .site-footer__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .site-footer__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 88px;
  }

  .site-footer__columns {
    display: flex;
    flex: none;
    gap: 88px;
  }

  .site-footer__title {
    margin-bottom: 16px;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    line-height: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__link,
  .site-footer__social {
    display: inline-flex;
    align-items: center;
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .site-footer__social {
    gap: 2px;
  }

  .site-footer__rule-wrap {
    padding-top: 32px;
  }

  .site-footer__rule {
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-beige) 30%, transparent);
  }

  .site-footer__brand {
    padding-top: 48px;
    text-align: center;
  }

  .site-footer__copyright {
    margin-top: 32px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    color: color-mix(in srgb, var(--color-beige) 60%, transparent);
  }

  .newsletter {
    width: 305px;
    flex: none;
  }

  .newsletter .site-footer__title {
    margin-bottom: 8px;
  }

  .newsletter__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .newsletter__row input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-none);
    background: transparent;
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
  }

  .newsletter__row input::placeholder {
    color: color-mix(in srgb, var(--color-beige) 60%, transparent);
    opacity: 1;
  }

  .newsletter__send {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-off-white);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    line-height: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .newsletter__rule {
    display: block;
    margin-top: 12px;
    border-top: 1px solid var(--color-beige);
  }

  .newsletter__errors {
    margin-top: 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
  }

  .icon-arrow-up-right {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .site-header__menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-burgundy);
    cursor: pointer;
  }

  .site-header__menu-icon,
  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    display: block;
    width: 18px;
    height: 1px;
    background: currentColor;
  }

  .site-header__menu-icon {
    position: relative;
  }

  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .site-header__menu-icon::before {
    top: -6px;
  }

  .site-header__menu-icon::after {
    top: 6px;
  }

  .site-header__desktop-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .site-header__drawer {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(6, 5, 5, 0.28);
  }

  .site-header__drawer[hidden] {
    display: none;
  }

  .site-header__drawer-panel {
    width: min(100%, 360px);
    height: 100%;
    padding: 24px var(--page-inset);
    background: var(--color-beige);
    color: var(--color-burgundy);
    overflow: auto;
  }

  .site-header__drawer-top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 32px;
  }

  .site-header__close {
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: var(--color-burgundy);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }

  .site-header__drawer-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__drawer-link {
    display: block;
    padding: 16px 0;
    border-bottom: 1px solid rgba(103, 13, 13, 0.16);
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1.44px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: center;
    margin-top: 24px;
  }

  .site-footer__policy {
    color: color-mix(in srgb, var(--color-beige) 80%, transparent);
    font-family: var(--font-sans);
    font-size: 12px;
    text-decoration: underline;
  }

  .site-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 24px;
  }

  .newsletter__success {
    margin-top: 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.3;
  }

  html.nav-open,
  html.nav-open body {
    overflow: hidden;
  }

  .site-header__cart.is-cart-updated,
  .site-header__drawer-link.is-cart-updated {
    animation: remelle-cart-pulse 0.7s ease;
  }

  @keyframes remelle-cart-pulse {
    0% {
      transform: scale(1);
    }
    35% {
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  html.popup-open,
  html.popup-open body {
    overflow: hidden;
  }

  .remelle-popup-host {
    position: relative;
    z-index: 90;
  }

  .remelle-popup {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(6, 5, 5, 0.42);
    opacity: 0;
    transition: opacity 0.22s ease;
  }

  .remelle-popup.is-visible {
    opacity: 1;
  }

  .remelle-popup.is-visible .remelle-popup__panel {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .remelle-popup__panel {
    width: min(420px, 100%);
    padding: 32px 28px;
    background: var(--color-off-white);
    color: #242424;
    font-family: var(--font-sans);
    box-shadow: 0 24px 64px rgba(6, 5, 5, 0.22);
    opacity: 0;
    transform: translateY(16px) scale(0.96);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .remelle-popup__eyebrow {
    margin: 0 0 12px;
    color: var(--color-burgundy);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-popup--error .remelle-popup__eyebrow {
    color: #242424;
  }

  .remelle-popup__message {
    margin: 0;
    color: #242424;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.35;
  }

  .remelle-popup__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .remelle-popup__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--color-burgundy);
    background: var(--color-burgundy);
    color: var(--color-off-white);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.96px;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .remelle-popup__btn--ghost {
    background: transparent;
    color: var(--color-burgundy);
  }

  .remelle-popup__btn:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  @media (max-width: 414px) {
    .remelle-popup__actions {
      flex-direction: column;
    }

    .remelle-popup__btn {
      width: 100%;
    }
  }

  @media (max-width: 1024px) {
    .site-footer__top {
      flex-direction: column;
      gap: 48px;
    }

    .site-footer__columns {
      flex-wrap: wrap;
      gap: 40px 48px;
    }

    .newsletter {
      width: min(305px, 100%);
    }
  }

  @media (max-width: 768px) {
    .site-header__menu-btn {
      display: inline-flex;
    }

    .site-header__desktop-links {
      display: none;
    }

    .site-header__bar {
      grid-template-columns: 40px 1fr auto;
      gap: 12px;
    }

    .site-header__group--start {
      justify-content: flex-start;
    }

    .site-header__wordmark {
      justify-self: center;
    }

    .wordmark--nav {
      width: 110px;
      height: 20px;
    }

    .site-footer {
      padding-top: 40px;
      padding-bottom: 28px;
    }

    .site-footer__top {
      gap: 28px;
    }

    .site-footer__columns {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 20px;
      width: 100%;
    }

    .site-footer__links {
      gap: 8px;
    }

    .site-footer__rule-wrap {
      padding-top: 20px;
    }

    .site-footer__brand {
      padding-top: 24px;
    }

    .site-footer__copyright,
    .site-footer__policies,
    .site-footer__payments {
      margin-top: 16px;
    }

    .wordmark--footer {
      width: min(220px, 72%);
    }

    .site-footer__title,
    .site-footer__link,
    .site-footer__social {
      white-space: normal;
    }
  }

  @media (max-width: 600px) {
    .announcement {
      height: auto;
      min-height: var(--header-announcement-height);
      padding: 8px 16px;
    }

    .site-header__bar {
      padding-inline: 16px;
    }

    .wordmark--nav {
      width: 96px;
    }
  }

  .shopify-policy__container {
    width: min(620px, 100%);
    margin-inline: auto;
    padding: 72px var(--page-inset) 140px;
  }

  .shopify-policy__title h1 {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .shopify-policy__body {
    margin-top: 48px;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 22px;
  }

  .shopify-policy__body p,
  .shopify-policy__body li {
    margin: 0;
  }

  .shopify-policy__body p + p,
  .shopify-policy__body li + li {
    margin-top: 10px;
  }

  .shopify-policy__body h2,
  .shopify-policy__body h3 {
    margin: 24px 0 0;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    line-height: 22px;
  }

  .shopify-policy__body h2 + p,
  .shopify-policy__body h3 + p,
  .shopify-policy__body h2 + ul,
  .shopify-policy__body h3 + ul,
  .shopify-policy__body h2 + ol,
  .shopify-policy__body h3 + ol {
    margin-top: 10px;
  }

  .shopify-policy__body ul,
  .shopify-policy__body ol {
    margin: 10px 0 0;
    padding-left: 1.2em;
  }

  .shopify-policy__body a {
    color: var(--color-burgundy);
  }

  @media (max-width: 768px) {
    .shopify-policy__container {
      padding: 48px var(--page-inset) 96px;
    }

    .shopify-policy__title h1 {
      font-size: 40px;
      line-height: 1;
    }
  }
{% endstylesheet %}
