{%- liquid
  assign product_collection = section.settings.collection
  if product_collection == blank and collections.all.products_count > 0
    assign product_collection = collections.all
  endif

  assign picked_products = section.settings.products
  assign use_picked = false
  if picked_products != blank and picked_products.size > 0
    assign use_picked = true
  endif

  assign has_other = false
  if use_picked
    for item in picked_products
      if item.id != product.id
        assign has_other = true
        break
      endif
    endfor
  elsif product_collection != blank
    for item in product_collection.products
      if item.id != product.id
        assign has_other = true
        break
      endif
    endfor
  endif
-%}

{%- if has_other or request.design_mode -%}
  <section
    class="remelle-recs"
    {% if section.settings.heading != blank %}
      aria-labelledby="RemelleRecsTitle-{{ section.id }}"
    {% endif %}
  >
    <div class="remelle-recs__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="remelle-recs__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="remelle-recs__heading" id="RemelleRecsTitle-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
    </div>

    {%- if has_other -%}
      <div class="remelle-recs__track" tabindex="0">
        {%- assign shown = 0 -%}
        {%- if use_picked -%}
          {%- for item in picked_products -%}
            {%- if shown >= section.settings.products_to_show -%}
              {%- break -%}
            {%- endif -%}
            {%- if item.id != product.id -%}
              {% render 'remelle-product-card',
                product: item,
                show_new_badge: section.settings.show_new_badge,
                badge_label: section.settings.badge_label,
                badge_tag: section.settings.badge_tag,
                new_products: section.settings.new_products,
                show_sale_badge: section.settings.show_sale_badge,
                sale_label: section.settings.sale_label,
                sale_tag: section.settings.sale_tag,
                sale_products: section.settings.sale_products,
                show_limited_badge: section.settings.show_limited_badge,
                limited_label: section.settings.limited_label,
                limited_tag: section.settings.limited_tag,
                limited_products: section.settings.limited_products,
                show_preorder_badge: section.settings.show_preorder_badge,
                preorder_label: section.settings.preorder_label,
                preorder_tag: section.settings.preorder_tag,
                preorder_products: section.settings.preorder_products,
                show_coming_soon_badge: section.settings.show_coming_soon_badge,
                coming_soon_label: section.settings.coming_soon_label,
                coming_soon_tag: section.settings.coming_soon_tag,
                coming_soon_products: section.settings.coming_soon_products,
                show_low_stock_badge: section.settings.show_low_stock_badge,
                low_stock_label: section.settings.low_stock_label,
                low_stock_threshold: section.settings.low_stock_threshold,
                low_stock_products: section.settings.low_stock_products
              %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for item in product_collection.products -%}
            {%- if shown >= section.settings.products_to_show -%}
              {%- break -%}
            {%- endif -%}
            {%- if item.id != product.id -%}
              {% render 'remelle-product-card',
                product: item,
                show_new_badge: section.settings.show_new_badge,
                badge_label: section.settings.badge_label,
                badge_tag: section.settings.badge_tag,
                new_products: section.settings.new_products,
                show_sale_badge: section.settings.show_sale_badge,
                sale_label: section.settings.sale_label,
                sale_tag: section.settings.sale_tag,
                sale_products: section.settings.sale_products,
                show_limited_badge: section.settings.show_limited_badge,
                limited_label: section.settings.limited_label,
                limited_tag: section.settings.limited_tag,
                limited_products: section.settings.limited_products,
                show_preorder_badge: section.settings.show_preorder_badge,
                preorder_label: section.settings.preorder_label,
                preorder_tag: section.settings.preorder_tag,
                preorder_products: section.settings.preorder_products,
                show_coming_soon_badge: section.settings.show_coming_soon_badge,
                coming_soon_label: section.settings.coming_soon_label,
                coming_soon_tag: section.settings.coming_soon_tag,
                coming_soon_products: section.settings.coming_soon_products,
                show_low_stock_badge: section.settings.show_low_stock_badge,
                low_stock_label: section.settings.low_stock_label,
                low_stock_threshold: section.settings.low_stock_threshold,
                low_stock_products: section.settings.low_stock_products
              %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="remelle-recs__controls">
        <div
          class="remelle-recs__progress"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          aria-label="{{ 'products.progress' | t }}"
        >
          <span class="remelle-recs__progress-fill"></span>
        </div>
        <div class="remelle-recs__arrows">
          <button class="remelle-recs__arrow" type="button" data-direction="prev" aria-label="{{ 'products.previous' | t }}">
            {% render 'icon-arrow-left' %}
          </button>
          <button class="remelle-recs__arrow" type="button" data-direction="next" aria-label="{{ 'products.next' | t }}">
            {% render 'icon-arrow-right' %}
          </button>
        </div>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .remelle-recs {
    padding: 104px 0 56px;
    overflow: hidden;
  }

  .remelle-recs__header {
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .remelle-recs__eyebrow {
    margin: 0 0 20px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-recs__heading {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .remelle-recs__track {
    --recs-track-inset: max(var(--page-inset), calc((100% - var(--page-width)) / 2 + var(--page-inset)));
    display: flex;
    gap: 16px;
    margin-top: 48px;
    padding-left: 0;
    padding-right: 0;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--recs-track-inset) var(--page-inset);
  }

  .remelle-recs__track::before,
  .remelle-recs__track::after {
    content: '';
    flex: 0 0 var(--recs-track-inset);
    width: var(--recs-track-inset);
    pointer-events: none;
  }

  .remelle-recs__track::after {
    flex-basis: var(--page-inset);
    width: var(--page-inset);
  }

  .remelle-recs__track::-webkit-scrollbar {
    display: none;
  }

  .remelle-recs__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(var(--page-width), 100%);
    height: 32px;
    margin: 32px auto 0;
    padding-inline: var(--page-inset);
  }

  .remelle-recs__progress {
    width: min(862px, calc(100% - 96px));
    height: 1px;
    background: rgba(103, 13, 13, 0.25);
  }

  .remelle-recs__progress-fill {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-burgundy);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .remelle-recs__arrows {
    display: flex;
    justify-content: space-between;
    width: 80px;
  }

  .remelle-recs__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-burgundy);
    cursor: pointer;
  }

  .remelle-recs__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .remelle-recs__arrow:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .remelle-recs {
      padding-top: 64px;
    }

    .remelle-recs__heading {
      font-size: 40px;
      line-height: 1.05;
    }

    .remelle-recs__track {
      --recs-track-inset: var(--page-inset);
      margin-top: 32px;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-inset);
    }

    .remelle-recs__track::before,
    .remelle-recs__track::after {
      flex-basis: var(--page-inset);
      width: var(--page-inset);
    }

    .remelle-recs .remelle-card {
      scroll-snap-align: start;
      scroll-margin-inline: 0;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.remelle-recs').forEach((section) => {
    const track = section.querySelector('.remelle-recs__track');
    const fill = section.querySelector('.remelle-recs__progress-fill');
    const progress = section.querySelector('.remelle-recs__progress');
    const previous = section.querySelector('[data-direction="prev"]');
    const next = section.querySelector('[data-direction="next"]');
    if (!track || !previous || !next) return;

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const ratio = track.scrollWidth === 0 ? 0 : (track.clientWidth + track.scrollLeft) / track.scrollWidth;
      const amount = Math.max(0, Math.min(1, ratio));
      if (fill) fill.style.transform = `scaleX(${amount})`;
      if (progress) progress.setAttribute('aria-valuenow', String(Math.round(amount * 100)));
      previous.disabled = track.scrollLeft <= 1;
      next.disabled = max <= 1 || track.scrollLeft >= max - 1;
    };

    const step = () => {
      const card = track.querySelector('.remelle-card');
      if (!card) return 379;
      return card.getBoundingClientRect().width + 16;
    };

    previous.addEventListener('click', () => {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    next.addEventListener('click', () => {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    track.addEventListener('scroll', update, { passive: true });
    update();
  });
{% endjavascript %}

