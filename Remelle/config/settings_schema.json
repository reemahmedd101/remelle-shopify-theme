[
  {
    "name": "theme_info",
    "theme_name": "Remelle",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:general.typography_note"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "color_burgundy",
        "default": "#670D0D",
        "label": "t:labels.burgundy"
      },
      {
        "type": "color",
        "id": "color_beige",
        "default": "#F5EDE3",
        "label": "t:labels.beige"
      },
      {
        "type": "color",
        "id": "color_off_white",
        "default": "#FAF5F0",
        "label": "t:labels.off_white"
      },
      {
        "type": "color",
        "id": "color_black",
        "default": "#060505",
        "label": "t:labels.black"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 8,
        "unit": "px",
        "label": "t:labels.page_width",
        "default": 1440
      },
      {
        "type": "range",
        "id": "page_inset",
        "min": 0,
        "max": 80,
        "step": 4,
        "unit": "px",
        "label": "t:labels.page_inset",
        "default": 48
      },
      {
        "type": "range",
        "id": "announcement_height",
        "min": 24,
        "max": 48,
        "step": 1,
        "unit": "px",
        "label": "t:labels.announcement_height",
        "default": 30
      },
      {
        "type": "range",
        "id": "navigation_height",
        "min": 48,
        "max": 80,
        "step": 1,
        "unit": "px",
        "label": "t:labels.navigation_height",
        "default": 56
      }
    ]
  },
