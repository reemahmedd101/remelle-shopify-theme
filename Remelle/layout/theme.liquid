<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {{ 'instrument-sans.woff2' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {{ 'instrument-serif.woff2' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <div class="block-container">
      {% render 'header' %}
    </div>

    <main>
      {{ content_for_layout }}
    </main>

    <div class="block-container">
      {% render 'footer' %}
    </div>
  </body>
</html>
