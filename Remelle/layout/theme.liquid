<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {{ 'instrument-sans.woff2' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {{ 'instrument-serif.woff2' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {{ 'snell-roundhand-regular.ttf' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% render 'chrome-styles' %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
    <script type="application/json" id="RemelleCartStrings">
      {
        "added": {{ 'product.added' | t | json }},
        "addedSuccess": {{ 'cart.added_success' | t | json }},
        "addedNamed": {{ 'cart.added_named' | t | json }},
        "viewCart": {{ 'cart.view_cart' | t | json }},
        "cartUrl": {{ routes.cart_url | json }},
        "cartLabel": {{ 'chrome.cart' | t | json }},
        "updated": {{ 'cart.updated' | t | json }},
        "removed": {{ 'cart.removed' | t | json }},
        "removeConfirm": {{ 'cart.remove_confirm' | t | json }},
        "addError": {{ 'cart.add_error' | t | json }},
        "updateError": {{ 'cart.update_error' | t | json }},
        "missingVariant": {{ 'cart.missing_variant' | t | json }},
        "maxQuantity": {{ 'cart.max_quantity' | t | json }},
        "close": {{ 'accessibility.close' | t | json }},
        "continueShopping": {{ 'cart.continue_shopping' | t | json }},
        "cancel": {{ 'cart.cancel' | t | json }},
        "confirm": {{ 'cart.confirm' | t | json }},
        "remove": {{ 'cart.remove' | t | json }},
        "successTitle": {{ 'cart.popup_success' | t | json }},
        "errorTitle": {{ 'cart.popup_error' | t | json }},
        "confirmTitle": {{ 'cart.popup_confirm' | t | json }}
      }
    </script>
    <script>
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches === false) {
        document.documentElement.classList.add('js-motion');
      }
    </script>
    <script type="application/json" id="RemelleEmailStrings">
      {
        "invalid": {{ 'chrome.email_invalid' | t | json }}
      }
    </script>
    <script type="application/json" id="RemelleCustomer">
      {
        "id": {% if customer %}{{ customer.id }}{% else %}null{% endif %}
      }
    </script>
    <script src="{{ 'remelle-motion.js' | asset_url }}" defer></script>
    <script src="{{ 'remelle-cart.js' | asset_url }}" defer></script>
    <script src="{{ 'remelle-email.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ request.page_type }}">
    <a class="skip-to-content visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {%- if request.page_type == 'policy' -%}
        {%- capture layout_content -%}{{ content_for_layout }}{%- endcapture -%}
        {%- assign child_parts = layout_content | split: "<h2>Children's Data</h2>" -%}
        {%- if child_parts.size > 1 -%}
          {%- assign child_rest = child_parts[1] | split: '<h2>Security and Retention of Your Information</h2>' -%}
          {%- capture layout_content -%}{{ child_parts[0] }}<h2>Security and Retention of Your Information</h2>{{ child_rest[1] }}{%- endcapture -%}
        {%- endif -%}
        {%- assign address_parts = layout_content | split: ' or contact us at ' -%}
        {%- if address_parts.size > 1 -%}
          {%- assign address_rest = address_parts[1] | split: 'Egypt.' -%}
          {%- capture layout_content -%}{{ address_parts[0] }}.{{ address_rest[1] }}{%- endcapture -%}
        {%- endif -%}
        {%- assign layout_content = layout_content | replace: 'reemahmedd10@gmail.com', '<a href="mailto:info@remelle.shop">info@remelle.shop</a>' -%}
        {{ layout_content }}
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {% sections 'footer-group' %}
    {%- unless request.page_type == 'cart' or request.page_type == 'product' -%}
      <a
        class="remelle-float-cart"
        href="{{ routes.cart_url }}"
        data-float-cart
        data-count-template="{{ 'chrome.cart_count' | t: count: '__COUNT__' | escape }}"
        aria-label="{{ 'chrome.cart_count' | t: count: cart.item_count }}"
        {% if cart.item_count == 0 %}hidden{% endif %}
      >
        <span class="remelle-float-cart__icon" aria-hidden="true">
          <img
            class="remelle-float-cart__image"
            src="{{ 'cart.png' | asset_url }}"
            alt=""
            width="26"
            height="26"
            loading="lazy"
            decoding="async"
          >
        </span>
        <span class="remelle-float-cart__count" data-cart-count aria-live="polite">{{ cart.item_count }}</span>
      </a>
    {%- endunless -%}
    <div id="RemellePopupHost" class="remelle-popup-host"></div>
  </body>
</html>
