{%- liquid
  assign product_collection = section.settings.collection
  if product_collection == blank and collections.all.products_count > 0
    assign product_collection = collections.all
  endif

  assign view_all_url = routes.all_products_collection_url
  if section.settings.collection != blank
    assign view_all_url = section.settings.collection.url
  endif

  assign picked_products = section.settings.products
  assign show_picked = false
  assign show_products = false
  if picked_products != blank and picked_products.size > 0
    assign show_picked = true
    assign show_products = true
  elsif product_collection != blank and product_collection.products_count > 0
    assign show_products = true
  endif
-%}

<section
  class="remelle-products"
  {% if section.settings.heading != blank %}
    aria-labelledby="RemelleProductsTitle-{{ section.id }}"
  {% endif %}
>
  <div class="remelle-products__header">
    <div class="remelle-products__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="remelle-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="remelle-products__heading" id="RemelleProductsTitle-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
    </div>
    {%- if section.settings.view_all_label != blank -%}
      <a class="remelle-products__view-all" href="{{ view_all_url }}">
        {{ section.settings.view_all_label | escape }}
        {% render 'icon-arrow-up-right' %}
      </a>
    {%- endif -%}
  </div>

  {%- if show_products -%}
    <div class="remelle-products__track" tabindex="0">
      {%- if show_picked -%}
        {%- for product in picked_products limit: section.settings.products_to_show -%}
          {% render 'remelle-product-card',
            product: product,
            show_new_badge: section.settings.show_new_badge,
            badge_label: section.settings.badge_label,
            badge_tag: section.settings.badge_tag,
            new_products: section.settings.new_products,
            show_sale_badge: section.settings.show_sale_badge,
            sale_label: section.settings.sale_label,
            sale_tag: section.settings.sale_tag,
            sale_products: section.settings.sale_products,
            show_limited_badge: section.settings.show_limited_badge,
            limited_label: section.settings.limited_label,
            limited_tag: section.settings.limited_tag,
            limited_products: section.settings.limited_products,
            show_preorder_badge: section.settings.show_preorder_badge,
            preorder_label: section.settings.preorder_label,
            preorder_tag: section.settings.preorder_tag,
            preorder_products: section.settings.preorder_products,
            show_coming_soon_badge: section.settings.show_coming_soon_badge,
            coming_soon_label: section.settings.coming_soon_label,
            coming_soon_tag: section.settings.coming_soon_tag,
            coming_soon_products: section.settings.coming_soon_products,
            show_low_stock_badge: section.settings.show_low_stock_badge,
            low_stock_label: section.settings.low_stock_label,
            low_stock_threshold: section.settings.low_stock_threshold,
            low_stock_products: section.settings.low_stock_products
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for product in product_collection.products limit: section.settings.products_to_show -%}
          {% render 'remelle-product-card',
            product: product,
            show_new_badge: section.settings.show_new_badge,
            badge_label: section.settings.badge_label,
            badge_tag: section.settings.badge_tag,
            new_products: section.settings.new_products,
            show_sale_badge: section.settings.show_sale_badge,
            sale_label: section.settings.sale_label,
            sale_tag: section.settings.sale_tag,
            sale_products: section.settings.sale_products,
            show_limited_badge: section.settings.show_limited_badge,
            limited_label: section.settings.limited_label,
            limited_tag: section.settings.limited_tag,
            limited_products: section.settings.limited_products,
            show_preorder_badge: section.settings.show_preorder_badge,
            preorder_label: section.settings.preorder_label,
            preorder_tag: section.settings.preorder_tag,
            preorder_products: section.settings.preorder_products,
            show_coming_soon_badge: section.settings.show_coming_soon_badge,
            coming_soon_label: section.settings.coming_soon_label,
            coming_soon_tag: section.settings.coming_soon_tag,
            coming_soon_products: section.settings.coming_soon_products,
            show_low_stock_badge: section.settings.show_low_stock_badge,
            low_stock_label: section.settings.low_stock_label,
            low_stock_threshold: section.settings.low_stock_threshold,
            low_stock_products: section.settings.low_stock_products
          %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="remelle-products__controls">
      <div
        class="remelle-products__progress"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-label="{{ 'products.progress' | t }}"
      >
        <span class="remelle-products__progress-fill"></span>
      </div>
      <div class="remelle-products__arrows">
        <button class="remelle-products__arrow" type="button" data-direction="prev" aria-label="{{ 'products.previous' | t }}">
          {% render 'icon-arrow-left' %}
        </button>
        <button class="remelle-products__arrow" type="button" data-direction="next" aria-label="{{ 'products.next' | t }}">
          {% render 'icon-arrow-right' %}
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .remelle-products {
    background: var(--color-off-white);
    padding: 80px 0 48px;
    overflow: hidden;
  }

  .remelle-products__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .remelle-products__eyebrow {
    margin: 0 0 20px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-products__heading {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .remelle-products__view-all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0 4px;
    border-bottom: 1px solid var(--color-burgundy);
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    line-height: 12px;
    letter-spacing: 1.6px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .remelle-products__view-all:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  .remelle-products__track {
    display: flex;
    gap: 16px;
    width: min(var(--page-content), calc(100% - (var(--page-inset) * 2)));
    margin: 48px auto 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .remelle-products__track::-webkit-scrollbar {
    display: none;
  }

  .remelle-products__controls[hidden] {
    display: none;
  }

  .remelle-products__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(var(--page-width), 100%);
    height: 32px;
    margin: 32px auto 0;
    padding-inline: var(--page-inset);
  }

  .remelle-products__progress {
    width: min(862px, calc(100% - 96px));
    height: 1px;
    background: rgba(103, 13, 13, 0.25);
  }

  .remelle-products__progress-fill {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-burgundy);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .remelle-products__arrows {
    display: flex;
    justify-content: space-between;
    width: 80px;
  }

  .remelle-products__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-burgundy);
    cursor: pointer;
  }

  .remelle-products__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .remelle-products__arrow:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .remelle-products {
      padding-top: 56px;
    }

    .remelle-products__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .remelle-products__heading {
      font-size: 40px;
      line-height: 1.05;
    }

    .remelle-products__track {
      margin-top: 32px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.remelle-products').forEach((section) => {
    if (section.dataset.carouselReady === 'true') return;
    section.dataset.carouselReady = 'true';
    const track = section.querySelector('.remelle-products__track');
    const fill = section.querySelector('.remelle-products__progress-fill');
    const progress = section.querySelector('.remelle-products__progress');
    const previous = section.querySelector('[data-direction="prev"]');
    const next = section.querySelector('[data-direction="next"]');

    const controls = section.querySelector('.remelle-products__controls');

    const update = () => {
      if (!track || !fill || !progress) return;
      const max = track.scrollWidth - track.clientWidth;
      const canScroll = max > 8;
      if (controls) controls.hidden = !canScroll;
      const ratio = track.scrollWidth === 0 ? 0 : (track.clientWidth + track.scrollLeft) / track.scrollWidth;
      const amount = Math.max(0, Math.min(1, ratio));
      fill.style.transform = `scaleX(${amount})`;
      progress.setAttribute('aria-valuenow', String(Math.round(amount * 100)));
      if (previous) previous.disabled = track.scrollLeft <= 1;
      if (next) next.disabled = !canScroll || track.scrollLeft >= max - 1;
    };

    const step = () => {
      const card = track.querySelector('.remelle-card');
      if (!card) return 379;
      return card.getBoundingClientRect().width + 16;
    };

    if (track && previous && next) {
      previous.addEventListener('click', () => {
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      });
      next.addEventListener('click', () => {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      });
      track.addEventListener('scroll', update, { passive: true });
      update();
      window.addEventListener('resize', update);
    }

  });
{% endjavascript %}

