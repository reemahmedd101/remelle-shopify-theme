{%- liquid
  assign picked_products = section.settings.products
  assign has_products = false
  if picked_products != blank and picked_products.size > 0
    assign has_products = true
  endif
  assign page_heading = section.settings.heading
  if page_heading == blank
    assign page_heading = 'products.coming_soon_heading' | t
  endif
  assign badge_text = section.settings.badge_label
  if badge_text == blank
    assign badge_text = 'products.coming_soon_badge' | t
  endif
  assign preorder_text = section.settings.preorder_label
  if preorder_text == blank
    assign preorder_text = 'products.preorder_badge' | t
  endif
  assign script_line = section.settings.script
  assign intro = section.settings.description
-%}

<section
  class="remelle-coming-soon{% if has_products %} remelle-coming-soon--ready{% endif %}"
  {% if page_heading != blank %}
    aria-labelledby="RemelleComingSoonTitle-{{ section.id }}"
  {% endif %}
>
  <div class="remelle-coming-soon__inner">
    <header class="remelle-coming-soon__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="remelle-coming-soon__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if page_heading != blank or script_line != blank -%}
        <h2 class="remelle-coming-soon__heading" id="RemelleComingSoonTitle-{{ section.id }}">
          {%- if page_heading != blank -%}
            <span class="remelle-coming-soon__serif">{{ page_heading | escape }}</span>
          {%- endif -%}
          {%- if script_line != blank -%}
            <span class="remelle-coming-soon__script">{{ script_line | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if intro != blank -%}
        <p class="remelle-coming-soon__body">{{ intro | escape }}</p>
      {%- endif -%}
    </header>

    {%- if has_products -%}
      <div class="remelle-coming-soon__stage">
        <div class="remelle-coming-soon__track" tabindex="0" data-coming-track>
          {%- for product in picked_products -%}
            {%- liquid
              assign cycle_images = false
              for preorder_product in section.settings.preorder_products
                if preorder_product.id == product.id
                  assign cycle_images = true
                endif
              endfor
            -%}
            <div class="remelle-coming-soon__piece">
              {% render 'remelle-product-card',
                product: product,
                show_coming_soon_badge: true,
                coming_soon_label: badge_text,
                coming_soon_products: picked_products,
                show_preorder_badge: true,
                preorder_label: preorder_text,
                preorder_products: section.settings.preorder_products,
                preorder_section_only: true,
                preorder_placement: 'bottom'
              %}
              {%- if cycle_images and product.images.size > 1 -%}
                <script type="application/json" data-coming-images>
                  [
                    {%- for image in product.images -%}
                      {{ image | image_url: width: 900, format: 'jpg' | json }}{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]
                </script>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="remelle-coming-soon__controls">
          <div
            class="remelle-coming-soon__progress"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            aria-label="{{ 'products.progress' | t }}"
          >
            <span class="remelle-coming-soon__progress-fill"></span>
          </div>
          <div class="remelle-coming-soon__arrows">
            <button class="remelle-coming-soon__arrow" type="button" data-direction="prev" aria-label="{{ 'products.previous' | t }}">
              {% render 'icon-arrow-left' %}
            </button>
            <button class="remelle-coming-soon__arrow" type="button" data-direction="next" aria-label="{{ 'products.next' | t }}">
              {% render 'icon-arrow-right' %}
            </button>
          </div>
        </div>
      </div>
    {%- elsif request.design_mode -%}
      <p class="remelle-coming-soon__empty">{{ 'products.coming_soon_empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .remelle-coming-soon {
    position: relative;
    overflow: hidden;
    background: var(--color-burgundy);
    color: var(--color-off-white);
    padding: 88px 0 72px;
  }

  .remelle-coming-soon__inner {
    position: relative;
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .remelle-coming-soon__intro {
    max-width: 760px;
    color: var(--color-off-white);
  }

  .remelle-coming-soon__eyebrow {
    margin: 0 0 18px;
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-coming-soon__heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin: 0;
    color: var(--color-off-white);
  }

  .remelle-coming-soon__serif {
    font-family: var(--font-serif);
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .remelle-coming-soon__script {
    margin-top: 0;
    color: inherit;
    font-family: var(--font-script);
    font-size: 56px;
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -1.4px;
  }

  .remelle-coming-soon__body {
    max-width: 460px;
    margin: 22px 0 0;
    color: rgba(243, 237, 228, 0.82);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.55;
  }

  .remelle-coming-soon__stage {
    margin-top: 48px;
  }

  .remelle-coming-soon__track {
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .remelle-coming-soon__track::-webkit-scrollbar {
    display: none;
  }

  .remelle-coming-soon__piece {
    flex: 0 0 min(363px, 78vw);
    scroll-snap-align: start;
  }

  .remelle-coming-soon .remelle-card {
    flex: none;
    width: 100%;
    max-width: none;
  }

  .remelle-coming-soon .remelle-card__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 363 / 484;
    background: transparent;
  }

  .remelle-coming-soon .remelle-card__media {
    position: relative;
    padding: 0;
  }

  .remelle-coming-soon .remelle-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .remelle-coming-soon .remelle-card__image--next {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.2s ease-in-out;
  }

  .remelle-coming-soon .remelle-card__image--next.is-showing {
    opacity: 1;
  }

  .remelle-coming-soon .remelle-card,
  .remelle-coming-soon .remelle-card__name,
  .remelle-coming-soon .remelle-card__price,
  .remelle-coming-soon .remelle-card__more {
    color: var(--color-off-white);
  }

  .remelle-coming-soon .remelle-card__preorder {
    color: var(--color-beige);
  }

  .remelle-coming-soon .remelle-card__add {
    background: var(--color-off-white);
    color: var(--color-burgundy);
  }

  .remelle-coming-soon .remelle-card__add:focus-visible,
  .remelle-coming-soon .remelle-card__name a:focus-visible,
  .remelle-coming-soon .remelle-card__media:focus-visible {
    outline-color: var(--color-beige);
  }

  .remelle-coming-soon__controls[hidden] {
    display: none;
  }

  .remelle-coming-soon__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 28px;
  }

  .remelle-coming-soon__progress {
    flex: 1 1 auto;
    height: 1px;
    background: rgba(243, 237, 228, 0.28);
  }

  .remelle-coming-soon__progress-fill {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-beige);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .remelle-coming-soon__arrows {
    display: flex;
    gap: 8px;
  }

  .remelle-coming-soon__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-off-white);
    cursor: pointer;
  }

  .remelle-coming-soon__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .remelle-coming-soon__arrow:focus-visible {
    outline: 1px solid var(--color-beige);
    outline-offset: 3px;
  }

  .remelle-coming-soon__empty {
    margin: 36px 0 0;
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .remelle-coming-soon {
      padding: 64px 0 48px;
    }

    .remelle-coming-soon__script {
      font-size: clamp(28px, 9vw, 56px);
      max-width: 100%;
    }

    .remelle-coming-soon__piece {
      flex-basis: min(300px, 82vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .remelle-coming-soon__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.remelle-coming-soon').forEach((section) => {
    if (section.dataset.comingReady === 'true') return;
    section.dataset.comingReady = 'true';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
      section.querySelectorAll('[data-coming-images]').forEach((node) => {
        let urls = [];
        try {
          urls = JSON.parse(node.textContent);
        } catch (error) {
          return;
        }
        if (!Array.isArray(urls) || urls.length < 2) return;
        const image = node.parentElement && node.parentElement.querySelector('.remelle-card__image');
        const media = image && image.parentElement;
        if (!image || !media) return;
        urls.forEach((url) => {
          const preload = new Image();
          preload.src = url;
        });
        image.removeAttribute('srcset');
        const next = image.cloneNode(false);
        next.classList.add('remelle-card__image--next');
        next.removeAttribute('srcset');
        next.alt = '';
        next.setAttribute('aria-hidden', 'true');
        media.appendChild(next);

        let index = 0;
        let blending = false;
        const blendTo = (upcoming) => {
          if (blending) return;
          blending = true;
          let settled = false;
          const finish = () => {
            if (settled) return;
            settled = true;
            next.classList.add('is-showing');
            window.setTimeout(() => {
              image.src = urls[upcoming];
              next.style.transition = 'none';
              next.classList.remove('is-showing');
              next.offsetHeight;
              next.style.transition = '';
              index = upcoming;
              blending = false;
            }, 1200);
          };
          if (next.getAttribute('src') === urls[upcoming] && next.complete) {
            finish();
            return;
          }
          next.addEventListener('load', finish, { once: true });
          next.src = urls[upcoming];
          if (next.complete) finish();
        };

        window.setInterval(() => {
          blendTo((index + 1) % urls.length);
        }, 5000);
      });
    }

    const track = section.querySelector('[data-coming-track]');
    const fill = section.querySelector('.remelle-coming-soon__progress-fill');
    const progress = section.querySelector('.remelle-coming-soon__progress');
    const previous = section.querySelector('[data-direction="prev"]');
    const next = section.querySelector('[data-direction="next"]');
    const controls = section.querySelector('.remelle-coming-soon__controls');
    if (!track || !previous || !next) return;

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const canScroll = max > 8;
      if (controls) controls.hidden = !canScroll;
      const ratio = track.scrollWidth === 0 ? 0 : (track.clientWidth + track.scrollLeft) / track.scrollWidth;
      const amount = Math.max(0, Math.min(1, ratio));
      if (fill) fill.style.transform = `scaleX(${amount})`;
      if (progress) progress.setAttribute('aria-valuenow', String(Math.round(amount * 100)));
      previous.disabled = track.scrollLeft <= 1;
      next.disabled = !canScroll || track.scrollLeft >= max - 1;
    };

    const step = () => {
      const piece = track.querySelector('.remelle-coming-soon__piece');
      if (!piece) return 400;
      return piece.getBoundingClientRect().width + 28;
    };

    previous.addEventListener('click', () => {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    next.addEventListener('click', () => {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    track.addEventListener('scroll', update, { passive: true });
    update();
    window.addEventListener('resize', update);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.coming_soon",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Next arrival"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "script",
      "label": "t:labels.coming_soon_script"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.coming_soon_description",
      "default": "A first look at pieces still being finished. Preorder the ones you want to wear first."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "t:labels.coming_soon_section_products",
      "info": "t:labels.coming_soon_section_products_info",
      "limit": 50
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "t:labels.coming_soon_label",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "preorder_label",
      "label": "t:labels.preorder_label",
      "default": "Pre-order"
    },
    {
      "type": "product_list",
      "id": "preorder_products",
      "label": "t:labels.coming_soon_preorder_products",
      "info": "t:labels.coming_soon_preorder_products_info",
      "limit": 50
    }
  ],
  "presets": [
    {
      "name": "t:general.coming_soon"
    }
  ]
}
{% endschema %}
