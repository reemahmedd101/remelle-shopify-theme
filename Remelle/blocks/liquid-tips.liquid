{% doc %}
  Renders a "Liquid tips" highlight card. One tip sentence is shown at a time.

  @param {string[]} [tips] - Translation keys for the tip sentences to choose
    from. One is shown at a time.

  @example
  {% render 'liquid-tips' %}
{% enddoc %}

{%- liquid
  assign tip_count = tips.size
  assign seed = 'now' | date: '%N'
-%}

<div class="highlight" {{ block.shopify_attributes }}>
  <h3>{{ 'hello_world.liquid_tips_title' | t }}</h3>

  {%- if tip_count > 0 -%}
    {%- assign index = seed | modulo: tip_count -%}
    {%- for tip in tips limit: 1 offset: index -%}
      <p class="highlight-description">{{ tip | t }}</p>
    {%- endfor -%}
  {%- endif -%}
</div>

{{ content }}

{% schema %}
{
  "name": "t:general.liquid_tips",
  "settings": []
}
{% endschema %}
