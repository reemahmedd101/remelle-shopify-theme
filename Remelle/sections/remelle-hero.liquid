{%- liquid
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  if button_link == blank
    assign button_link = routes.all_products_collection_url
  endif

  assign heading_source = section.settings.heading | newline_to_br
  assign heading_lines = heading_source | split: '<br />'
  if heading_lines.size == 1
    assign heading_lines = heading_source | split: '<br>'
  endif

  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign use_blocks = false
  assign slide_count = 0

  if slide_blocks.size > 0
    for block in slide_blocks
      if block.settings.image != blank or block.settings.image_mobile != blank
        assign use_blocks = true
        assign slide_count = slide_count | plus: 1
      endif
    endfor
  endif

  unless use_blocks
    if section.settings.image != blank or section.settings.image_mobile != blank
      assign slide_count = slide_count | plus: 1
    else
      assign slide_count = slide_count | plus: 1
    endif
    if section.settings.image_2 != blank or section.settings.image_2_mobile != blank
      assign slide_count = slide_count | plus: 1
    endif
  endunless
-%}

<section
  class="remelle-hero"
  data-remelle-hero
  data-interval="3000"
  {% if section.settings.heading != blank %}
    aria-labelledby="RemelleHeroTitle-{{ section.id }}"
  {% endif %}
  aria-roledescription="{{ 'hero.carousel' | t | escape }}"
>
  <div class="remelle-hero__slides">
    {%- if use_blocks -%}
      {%- assign rendered_slides = 0 -%}
      {%- for block in slide_blocks -%}
        {%- liquid
          assign slide_image = block.settings.image
          assign slide_mobile = block.settings.image_mobile
        -%}
        {%- if slide_image != blank or slide_mobile != blank -%}
          {%- liquid
            assign slide_alt = block.settings.image_alt | default: slide_image.alt | default: shop.name
            assign is_first = false
            if rendered_slides == 0
              assign is_first = true
            endif
            assign rendered_slides = rendered_slides | plus: 1
          -%}
          <div
            class="remelle-hero__slide{% if is_first %} is-active{% endif %}"
            data-hero-slide
            data-heading="{{ block.settings.heading | escape }}"
            data-description="{{ block.settings.description | escape }}"
            data-button-label="{{ block.settings.button_label | escape }}"
            data-button-link="{{ block.settings.button_link | escape }}"
            {% unless is_first %}aria-hidden="true"{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- render 'remelle-hero-media',
              image: slide_image,
              image_mobile: slide_mobile,
              alt: slide_alt,
              eager: is_first,
              section_index: section.index
            -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- liquid
        assign slide_one = section.settings.image
        assign slide_one_mobile = section.settings.image_mobile
        assign slide_one_alt = section.settings.image_alt | default: slide_one.alt
        assign slide_two = section.settings.image_2
        assign slide_two_mobile = section.settings.image_2_mobile
        assign slide_two_alt = section.settings.image_2_alt | default: slide_two.alt
      -%}
      <div class="remelle-hero__slide is-active" data-hero-slide>
        {%- render 'remelle-hero-media',
          image: slide_one,
          image_mobile: slide_one_mobile,
          alt: slide_one_alt,
          eager: true,
          section_index: section.index,
          fallback_asset: true
        -%}
      </div>
      {%- if slide_two != blank or slide_two_mobile != blank -%}
        <div class="remelle-hero__slide" data-hero-slide aria-hidden="true">
          {%- render 'remelle-hero-media',
            image: slide_two,
            image_mobile: slide_two_mobile,
            alt: slide_two_alt,
            eager: false,
            section_index: section.index
          -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div
    class="remelle-hero__copy"
    data-hero-copy
    data-default-heading="{{ section.settings.heading | escape }}"
    data-default-description="{{ section.settings.description | escape }}"
    data-default-button-label="{{ button_label | escape }}"
    data-default-button-link="{{ button_link | escape }}"
  >
    {%- if section.settings.eyebrow != blank -%}
      <p class="remelle-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="remelle-hero__heading" id="RemelleHeroTitle-{{ section.id }}" data-hero-heading>
        {%- for line in heading_lines -%}
          {%- assign line_text = line | strip -%}
          {%- if line_text != blank -%}
            <span class="remelle-hero__line">{{ line_text | escape }}</span>
          {%- endif -%}
        {%- endfor -%}
      </h1>
    {%- else -%}
      <h1 class="remelle-hero__heading" id="RemelleHeroTitle-{{ section.id }}" data-hero-heading hidden></h1>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="remelle-hero__description" data-hero-description>{{ section.settings.description | escape | newline_to_br }}</p>
    {%- else -%}
      <p class="remelle-hero__description" data-hero-description hidden></p>
    {%- endif -%}
    {%- if button_label != blank -%}
      <a class="remelle-hero__button" href="{{ button_link }}" data-hero-button>
        <span data-hero-button-label>{{ button_label | escape }}</span>
        {% render 'icon-arrow-up-right' %}
      </a>
    {%- else -%}
      <a class="remelle-hero__button" href="{{ button_link }}" data-hero-button hidden>
        <span data-hero-button-label></span>
        {% render 'icon-arrow-up-right' %}
      </a>
    {%- endif -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="remelle-hero__index" role="tablist" aria-label="{{ 'hero.slides' | t | escape }}">
      {%- for i in (1..slide_count) -%}
        <button
          class="remelle-hero__digit{% if forloop.first %} is-active{% endif %}"
          type="button"
          role="tab"
          data-hero-digit
          aria-label="{{ 'hero.slide_n' | t: number: i | escape }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        >
          <span>{% if i < 10 %}0{% endif %}{{ i }}</span>
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  main > :first-child:has(.remelle-hero) {
    margin-top: -1px;
  }

  .remelle-hero {
    position: relative;
    height: 740px;
    overflow: hidden;
    background: var(--color-black);
    color: #fffdfc;
  }

  .remelle-hero__slides,
  .remelle-hero__slide {
    position: absolute;
    inset: 0;
  }

  .remelle-hero__slide {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.9s ease, visibility 0.9s ease;
    z-index: 0;
  }

  .remelle-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .remelle-hero__slide picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .remelle-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .remelle-hero__slide::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(20, 8, 7, 0.02), rgba(20, 8, 7, 0.4));
    pointer-events: none;
  }

  .remelle-hero__copy {
    position: absolute;
    z-index: 2;
    top: 314px;
    left: max(var(--page-inset), calc((100% - var(--page-width)) / 2 + var(--page-inset)));
    width: min(720px, calc(100% - var(--page-inset) * 2));
  }

  .remelle-hero__eyebrow {
    margin: 0 0 20px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-hero__heading {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    color: #fffdfc;
    font-family: var(--font-serif);
    font-size: 74px;
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.01em;
  }

  .remelle-hero__heading[hidden],
  .remelle-hero__description[hidden],
  .remelle-hero__button[hidden] {
    display: none;
  }

  .remelle-hero__description {
    margin: 12px 0 0;
    color: #d6d6d6;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 18px;
    letter-spacing: 0;
    white-space: normal;
  }

  .remelle-hero__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    margin-top: 40px;
    padding: 0 20px;
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-none);
    background: var(--color-beige);
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.96px;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .remelle-hero__button .icon-arrow-up-right {
    width: 24px;
    height: 24px;
  }

  .remelle-hero__button:focus-visible {
    outline: 1px solid var(--color-beige);
    outline-offset: 3px;
  }

  .remelle-hero__index {
    position: absolute;
    z-index: 2;
    right: max(var(--page-inset), calc((100% - var(--page-width)) / 2 + var(--page-inset)));
    bottom: 42px;
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }

  .remelle-hero__digit {
    padding: 0;
    border: 0;
    background: transparent;
    color: #fffdfc;
    opacity: 0.3;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 0;
    cursor: pointer;
  }

  .remelle-hero__digit.is-active {
    opacity: 1;
  }

  .remelle-hero__digit:focus-visible span {
    outline: 1px solid #fffdfc;
    outline-offset: 4px;
  }

  @media (max-width: 720px) {
    .remelle-hero {
      height: min(740px, calc(100svh - var(--header-height)));
    }

    .remelle-hero__heading {
      font-size: clamp(36px, 10vw, 74px);
    }

    .remelle-hero__copy {
      top: auto;
      bottom: 72px;
      left: var(--page-inset);
      width: calc(100% - var(--page-inset) * 2);
    }

    .remelle-hero__description {
      max-width: 34em;
    }

    .remelle-hero__button {
      max-width: 100%;
      height: 48px;
      padding-block: 0;
      font-size: 11px;
      letter-spacing: 0.64px;
      white-space: nowrap;
    }

    .remelle-hero__index {
      bottom: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .remelle-hero__slide {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const heroes = document.querySelectorAll('[data-remelle-hero]');

    heroes.forEach((hero) => {
      if (hero.dataset.remelleHeroBound === 'true') return;
      hero.dataset.remelleHeroBound = 'true';

      const slides = Array.from(hero.querySelectorAll('[data-hero-slide]'));
      const digits = Array.from(hero.querySelectorAll('[data-hero-digit]'));
      if (slides.length < 2) return;

      const copy = hero.querySelector('[data-hero-copy]');
      const headingEl = hero.querySelector('[data-hero-heading]');
      const descriptionEl = hero.querySelector('[data-hero-description]');
      const buttonEl = hero.querySelector('[data-hero-button]');
      const buttonLabelEl = hero.querySelector('[data-hero-button-label]');
      const interval = Number(hero.dataset.interval) || 3000;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let index = Math.max(
        0,
        slides.findIndex((slide) => slide.classList.contains('is-active'))
      );
      let timer = null;
      let paused = false;

      const setLines = (node, text) => {
        if (!node) return;
        node.replaceChildren();
        String(text || '')
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter(Boolean)
          .forEach((line) => {
            const span = document.createElement('span');
            span.className = 'remelle-hero__line';
            span.textContent = line;
            node.appendChild(span);
          });
      };

      const setHtmlBreaks = (node, text) => {
        if (!node) return;
        node.textContent = '';
        const parts = String(text || '').split(/\r?\n/);
        parts.forEach((part, i) => {
          node.appendChild(document.createTextNode(part));
          if (i < parts.length - 1) node.appendChild(document.createElement('br'));
        });
      };

      const applyCopy = (slide) => {
        if (!copy) return;
        const heading = (slide.dataset.heading || '').trim() || copy.dataset.defaultHeading || '';
        const description =
          (slide.dataset.description || '').trim() || copy.dataset.defaultDescription || '';
        const buttonLabel =
          (slide.dataset.buttonLabel || '').trim() || copy.dataset.defaultButtonLabel || '';
        const buttonLink =
          (slide.dataset.buttonLink || '').trim() || copy.dataset.defaultButtonLink || '';

        if (headingEl) {
          setLines(headingEl, heading);
          headingEl.hidden = !heading;
        }
        if (descriptionEl) {
          setHtmlBreaks(descriptionEl, description);
          descriptionEl.hidden = !description;
        }
        if (buttonEl) {
          if (buttonLabelEl) buttonLabelEl.textContent = buttonLabel;
          if (buttonLink) buttonEl.setAttribute('href', buttonLink);
          buttonEl.hidden = !buttonLabel;
        }
      };

      const show = (nextIndex) => {
        index = ((nextIndex % slides.length) + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === index;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
          if (active) {
            slide.querySelectorAll('img[loading="lazy"]').forEach((img) => {
              img.loading = 'eager';
            });
          }
        });
        digits.forEach((digit, i) => {
          const active = i === index;
          digit.classList.toggle('is-active', active);
          digit.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        applyCopy(slides[index]);
      };

      const stop = () => {
        if (timer) {
          window.clearInterval(timer);
          timer = null;
        }
      };

      const start = () => {
        stop();
        if (reduceMotion || paused || slides.length < 2) return;
        timer = window.setInterval(() => show(index + 1), interval);
      };

      digits.forEach((digit, i) => {
        digit.addEventListener('click', () => {
          show(i);
          paused = true;
          stop();
          window.setTimeout(() => {
            paused = false;
            start();
          }, interval * 2);
        });
      });

      hero.addEventListener('mouseenter', () => {
        paused = true;
        stop();
      });
      hero.addEventListener('mouseleave', () => {
        paused = false;
        start();
      });
      hero.addEventListener('focusin', () => {
        paused = true;
        stop();
      });
      hero.addEventListener('focusout', (event) => {
        if (hero.contains(event.relatedTarget)) return;
        paused = false;
        start();
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stop();
        } else if (!paused) {
          start();
        }
      });

      show(index);
      start();
    });
  })();
{% endjavascript %}

