{% doc %}
  Shared styles for the announcement bar, navigation, and footer.

  @example
  {% render 'chrome-styles' %}
{% enddoc %}

{% stylesheet %}
  main {
    flex: 1 0 auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-to-content:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    width: auto;
    height: auto;
    margin: 0;
    padding: 12px 16px;
    overflow: visible;
    clip: auto;
    background: var(--color-burgundy);
    color: var(--color-off-white);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: normal;
  }

  /* Announcement + nav are sibling section wrappers — stack sticky offsets. */
  .shopify-section-group-header-group:has(.announcement) {
    position: sticky;
    top: 0;
    z-index: 41;
    background: var(--color-burgundy);
  }

  .shopify-section-group-header-group:has(.site-header) {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-beige);
  }

  body:has(.announcement) .shopify-section-group-header-group:has(.site-header) {
    top: var(--header-announcement-height);
  }

  .announcement {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--header-announcement-height);
    background: var(--color-burgundy);
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    line-height: 12px;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
  }

  .site-header {
    background: var(--color-beige);
    color: var(--color-burgundy);
  }

  .site-header__bar {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    height: var(--header-nav-height);
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .site-header__wordmark {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    transform: translate(-50%, -50%);
  }

  .site-header__group {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .site-header__group--end {
    justify-content: flex-end;
  }

  .site-nav-link {
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .site-nav-link:hover {
    opacity: 0.62;
  }

  .site-header__account {
    display: inline-flex;
    color: var(--color-burgundy);
    --icon-stroke-width: 1.25;
    --shopify-account-color-accent: var(--color-burgundy);
    --shopify-account-color-accent-hover: var(--color-burgundy);
    --shopify-account-color-accent-text: var(--color-off-white);
    --shopify-account-color-background: var(--color-off-white);
    --shopify-account-color-text: var(--color-burgundy);
    --shopify-account-color-text-subdued: rgba(103, 13, 13, 0.62);
    --shopify-account-color-border: rgba(103, 13, 13, 0.22);
    --shopify-account-color-background-subdued: var(--color-beige);
    --shopify-account-color-card-background: var(--color-beige);
    --shopify-account-color-card-text: var(--color-burgundy);
    --shopify-account-color-control-background: var(--color-off-white);
    --shopify-account-color-control-text: var(--color-burgundy);
    --shopify-account-color-shadow: transparent;
    --shopify-account-font-body: var(--font-sans);
    --shopify-account-font-heading: var(--font-serif);
    --shopify-account-font-body-weight: 400;
    --shopify-account-font-heading-weight: 400;
    --shopify-account-radius-base: 0;
    --shopify-account-radius-button: 0;
    --shopify-account-radius-button-small: 0;
    --shopify-account-radius-dialog: 0;
    --shopify-account-radius-input: 0;
    --shopify-account-avatar-size: 32px;
    --shopify-account-signed-in-avatar-size: 28px;
    --shopify-account-signed-in-avatar-color-background: var(--color-burgundy);
    --shopify-account-signed-in-avatar-color-text: var(--color-off-white);
  }

  .site-header__account-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .site-header__account-icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .site-header__account-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  shopify-account::part(signed-out-avatar) {
    padding: 0;
    width: 32px;
    height: 32px;
    color: var(--color-burgundy);
  }

  .wordmark {
    display: block;
    object-fit: contain;
  }

  .wordmark--nav {
    width: 128px;
    height: 24px;
  }

  .wordmark--footer {
    width: 469px;
    height: auto;
    margin-inline: auto;
  }

  .site-header a:focus-visible,
  .site-footer a:focus-visible,
  .site-footer button:focus-visible,
  .site-footer input:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 2px;
  }

  .site-footer {
    background: var(--color-burgundy);
    color: var(--color-beige);
    padding-top: 80px;
    padding-bottom: 48px;
  }

  .site-footer__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-inset);
  }

  .site-footer__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 88px;
  }

  .site-footer__columns {
    display: flex;
    flex: none;
    gap: 88px;
  }

  .site-footer__title {
    margin-bottom: 16px;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    line-height: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__link,
  .site-footer__social {
    display: inline-flex;
    align-items: center;
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .site-footer__social {
    gap: 2px;
  }

  .site-footer__rule-wrap {
    padding-top: 32px;
  }

  .site-footer__rule {
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-beige) 30%, transparent);
  }

  .site-footer__brand {
    padding-top: 48px;
    text-align: center;
  }

  .site-footer__copyright {
    margin-top: 32px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    color: color-mix(in srgb, var(--color-beige) 60%, transparent);
  }

  .newsletter {
    width: 305px;
    flex: none;
  }

  .newsletter .site-footer__title {
    margin-bottom: 8px;
  }

  .newsletter__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .newsletter__row input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-none);
    background: transparent;
    color: var(--color-beige);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
  }

  .newsletter__row input::placeholder {
    color: color-mix(in srgb, var(--color-beige) 60%, transparent);
    opacity: 1;
  }

  .newsletter__send {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-off-white);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    line-height: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .newsletter__rule {
    display: block;
    margin-top: 12px;
    border-top: 1px solid var(--color-beige);
  }

  .newsletter__errors {
    margin-top: 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
  }

  .icon-arrow-up-right {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .site-header__menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-burgundy);
    cursor: pointer;
  }

  .site-header__menu-icon,
  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    display: block;
    width: 18px;
    height: 1px;
    background: currentColor;
  }

  .site-header__menu-icon {
    position: relative;
  }

  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .site-header__menu-icon::before {
    top: -6px;
  }

  .site-header__menu-icon::after {
    top: 6px;
  }

  .site-header__desktop-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .site-header__drawer {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(6, 5, 5, 0.28);
  }

  .js-motion .site-header__drawer {
    opacity: 0;
    transition: opacity 0.32s ease;
  }

  .js-motion .site-header__drawer.is-open {
    opacity: 1;
  }

  .site-header__drawer[hidden] {
    display: none;
  }

  .site-header__drawer-panel {
    width: min(100%, 360px);
    height: 100%;
    padding: 24px var(--page-inset);
    background: var(--color-beige);
    color: var(--color-burgundy);
    overflow: auto;
  }

  .js-motion .site-header__drawer-panel {
    transform: translateX(-100%);
    transition: transform 0.38s ease;
  }

  .js-motion .site-header__drawer.is-open .site-header__drawer-panel {
    transform: none;
  }

  .js-motion .site-header__drawer.is-open .site-header__drawer-links li {
    animation: remelle-link-in 0.45s ease both;
  }

  .js-motion .site-header__drawer.is-open .site-header__drawer-links li:nth-child(1) { animation-delay: 0.08s; }
  .js-motion .site-header__drawer.is-open .site-header__drawer-links li:nth-child(2) { animation-delay: 0.14s; }
  .js-motion .site-header__drawer.is-open .site-header__drawer-links li:nth-child(3) { animation-delay: 0.2s; }
  .js-motion .site-header__drawer.is-open .site-header__drawer-links li:nth-child(4) { animation-delay: 0.26s; }
  .js-motion .site-header__drawer.is-open .site-header__drawer-links li:nth-child(5) { animation-delay: 0.32s; }

  @keyframes remelle-link-in {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .site-header__drawer-top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 32px;
  }

  .site-header__close {
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: var(--color-burgundy);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }

  .site-header__drawer-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__drawer-link {
    display: block;
    padding: 16px 0;
    border-bottom: 1px solid rgba(103, 13, 13, 0.16);
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1.44px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: center;
    margin-top: 24px;
  }

  .site-footer__policy {
    color: color-mix(in srgb, var(--color-beige) 80%, transparent);
    font-family: var(--font-sans);
    font-size: 12px;
    text-decoration: underline;
  }

  .site-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 24px;
  }

  .newsletter__success {
    margin-top: 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.3;
  }

  html.nav-open,
  html.nav-open body {
    overflow: hidden;
  }

  .site-header__cart.is-cart-updated,
  .site-header__drawer-link.is-cart-updated {
    animation: remelle-cart-pulse 0.7s ease;
  }

  @keyframes remelle-cart-pulse {
    0% {
      transform: scale(1);
    }
    35% {
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  .remelle-float-cart {
    position: fixed;
    right: 24px;
    bottom: calc(24px + env(safe-area-inset-bottom));
    z-index: 25;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: 1px solid #f5ede3;
    border-radius: var(--radius-none);
    background: #670d0d;
    color: #f5ede3;
    text-decoration: none;
    box-shadow: none;
  }

  .remelle-float-cart[hidden] {
    display: none !important;
  }

  body:has(.remelle-float-cart:not([hidden])) {
    padding-bottom: calc(88px + env(safe-area-inset-bottom));
  }

  html.popup-open .remelle-float-cart {
    visibility: hidden;
    pointer-events: none;
  }

  .remelle-float-cart__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
  }

  .remelle-float-cart__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .remelle-float-cart__count {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border: 1px solid #f5ede3;
    border-radius: var(--radius-none);
    background: #f5ede3;
    color: #670d0d;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    line-height: 18px;
    letter-spacing: 0;
    text-align: center;
  }

  .remelle-float-cart.is-pop {
    animation: remelle-float-pop 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes remelle-float-pop {
    0% {
      opacity: 0.88;
      transform: translateY(6px) scale(0.96);
    }
    45% {
      opacity: 1;
      transform: translateY(-2px) scale(1.04);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .remelle-float-cart:focus-visible {
    outline: 1px solid var(--color-off-white);
    outline-offset: 3px;
  }

  html.nav-open .remelle-float-cart {
    visibility: hidden;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .remelle-float-cart {
      right: 16px;
      bottom: calc(16px + env(safe-area-inset-bottom));
      width: 48px;
      height: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .remelle-float-cart.is-pop {
      animation: none;
    }
  }

  .remelle-email-error {
    margin: 8px 0 0;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
  }

  .newsletter .remelle-email-error {
    color: var(--color-beige);
  }

  .remelle-input--invalid,
  .newsletter__row input.remelle-input--invalid,
  .remelle-contact__input.remelle-input--invalid,
  .remelle-customer__input.remelle-input--invalid {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 0;
  }

  .newsletter__row input.remelle-input--invalid {
    outline-color: var(--color-beige);
  }

  html.popup-open,
  html.popup-open body {
    overflow: hidden;
  }

  .remelle-popup-host {
    position: relative;
    z-index: 90;
  }

  .remelle-popup {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(6, 5, 5, 0.42);
    opacity: 0;
    transition: opacity 0.22s ease;
  }

  .remelle-popup.is-visible {
    opacity: 1;
  }

  .remelle-popup.is-visible .remelle-popup__panel {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .js-motion .remelle-reveal {
    opacity: 0;
    transition: opacity 0.8s ease, transform 0.25s ease;
    transition-delay: var(--reveal-delay, 0ms), 0ms;
  }

  .js-motion .remelle-reveal.is-in {
    opacity: 1;
  }

  .js-motion .remelle-hero__image {
    animation: remelle-hero-settle 1.6s ease both;
  }

  @keyframes remelle-hero-settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  .remelle-hero__button,
  .remelle-story__button,
  .remelle-about-invite__button,
  .remelle-contact__submit,
  .remelle-pdp__add,
  .remelle-products__view-all,
  .remelle-about-faq__link {
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  @media (hover: hover) {
    .remelle-hero__button:hover,
    .remelle-story__button:hover,
    .remelle-about-invite__button:hover,
    .remelle-contact__submit:hover,
    .remelle-pdp__add:hover {
      transform: translateY(-2px);
    }

    .remelle-products__view-all:hover,
    .remelle-about-faq__link:hover,
    .site-footer__link:hover,
    .site-footer__social:hover {
      opacity: 0.62;
    }
  }

  .site-footer__link,
  .site-footer__social {
    transition: opacity 0.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .js-motion .remelle-reveal,
    .js-motion .remelle-hero__image,
    .js-motion .site-header__drawer,
    .js-motion .site-header__drawer-panel,
    .js-motion .site-header__drawer.is-open .site-header__drawer-links li {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .remelle-popup__panel {
    width: min(420px, 100%);
    padding: 32px 28px;
    background: var(--color-off-white);
    color: #242424;
    font-family: var(--font-sans);
    box-shadow: 0 24px 64px rgba(6, 5, 5, 0.22);
    opacity: 0;
    transform: translateY(16px) scale(0.96);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .remelle-popup__eyebrow {
    margin: 0 0 12px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-popup--error .remelle-popup__eyebrow {
    color: #242424;
  }

  .remelle-popup__message {
    margin: 0;
    color: #242424;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.35;
  }

  .remelle-popup__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .remelle-popup__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--color-burgundy);
    background: var(--color-burgundy);
    color: var(--color-off-white);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.96px;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .remelle-popup__btn--ghost {
    background: transparent;
    color: var(--color-burgundy);
  }

  .remelle-popup__btn:focus-visible {
    outline: 1px solid var(--color-burgundy);
    outline-offset: 3px;
  }

  @media (max-width: 414px) {
    .remelle-popup__actions {
      flex-direction: column;
    }

    .remelle-popup__btn {
      width: 100%;
    }
  }

  @media (max-width: 1024px) {
    .site-footer__top {
      flex-direction: column;
      gap: 48px;
    }

    .site-footer__columns {
      flex-wrap: wrap;
      gap: 40px 48px;
    }

    .newsletter {
      width: min(305px, 100%);
    }
  }

  @media (max-width: 768px) {
    .site-header__menu-btn {
      display: inline-flex;
    }

    .site-header__desktop-links {
      display: none;
    }

    .site-header__bar {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 12px;
    }

    .site-header__group--start {
      justify-content: flex-start;
    }

    .wordmark--nav {
      width: 110px;
      height: 20px;
    }

    .site-footer {
      padding-top: 40px;
      padding-bottom: 28px;
    }

    .site-footer__top {
      gap: 28px;
    }

    .site-footer__columns {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 20px;
      width: 100%;
    }

    .site-footer__links {
      gap: 8px;
    }

    .site-footer__rule-wrap {
      padding-top: 20px;
    }

    .site-footer__brand {
      padding-top: 24px;
    }

    .site-footer__copyright,
    .site-footer__policies,
    .site-footer__payments {
      margin-top: 16px;
    }

    .wordmark--footer {
      width: min(220px, 72%);
    }

    .site-footer__title,
    .site-footer__link,
    .site-footer__social {
      white-space: normal;
    }
  }

  @media (max-width: 600px) {
    .announcement {
      height: auto;
      min-height: var(--header-announcement-height);
      padding: 8px 16px;
    }

    .site-header__bar {
      padding-inline: 16px;
    }

    .wordmark--nav {
      width: 96px;
    }
  }

  .shopify-policy__container {
    width: min(620px, 100%);
    margin-inline: auto;
    padding: 72px var(--page-inset) 140px;
  }

  .shopify-policy__title h1 {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .shopify-policy__body {
    margin-top: 48px;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 22px;
  }

  .shopify-policy__body p,
  .shopify-policy__body li {
    margin: 0;
  }

  .shopify-policy__body p + p,
  .shopify-policy__body li + li {
    margin-top: 10px;
  }

  .shopify-policy__body h2,
  .shopify-policy__body h3 {
    margin: 24px 0 0;
    color: #242424;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    line-height: 22px;
  }

  .shopify-policy__body h2 + p,
  .shopify-policy__body h3 + p,
  .shopify-policy__body h2 + ul,
  .shopify-policy__body h3 + ul,
  .shopify-policy__body h2 + ol,
  .shopify-policy__body h3 + ol {
    margin-top: 10px;
  }

  .shopify-policy__body ul,
  .shopify-policy__body ol {
    margin: 10px 0 0;
    padding-left: 1.2em;
  }

  .shopify-policy__body a {
    color: var(--color-burgundy);
  }

  @media (max-width: 768px) {
    .shopify-policy__container {
      padding: 48px var(--page-inset) 96px;
    }

    .shopify-policy__title h1 {
      font-size: 40px;
      line-height: 1;
    }
  }

  html.remelle-sheet-open,
  html.remelle-sheet-open body {
    overflow: hidden;
    touch-action: none;
  }

  .remelle-quick-sheet {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    justify-content: center;
    background: rgba(6, 5, 5, 0);
    opacity: 0;
    pointer-events: none;
    transition: background 0.28s ease, opacity 0.28s ease;
  }

  .remelle-quick-sheet.is-visible {
    background: rgba(6, 5, 5, 0.42);
    opacity: 1;
    pointer-events: auto;
  }

  .remelle-quick-sheet__panel {
    position: relative;
    margin: 0;
    overflow: auto;
    background: #faf5f0;
    color: #060505;
    font-family: var(--font-sans);
    -webkit-overflow-scrolling: touch;
  }

  .remelle-quick-sheet__handle {
    display: none;
    width: 42px;
    height: 4px;
    margin: 0 auto 14px;
    border-radius: 99px;
    background: rgba(103, 13, 13, 0.22);
  }

  .remelle-quick-sheet__close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #670d0d;
    cursor: pointer;
  }

  .remelle-quick-sheet__close svg {
    width: 18px;
    height: 18px;
  }

  .remelle-quick-sheet__product {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    padding-right: 36px;
  }

  .remelle-quick-sheet__image {
    width: 88px;
    height: 118px;
    object-fit: cover;
    background: #f5ede3;
  }

  .remelle-quick-sheet__image--empty {
    display: block;
  }

  .remelle-quick-sheet__name {
    margin: 0;
    color: #060505;
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .remelle-quick-sheet__price {
    margin: 8px 0 0;
    color: #670d0d;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }

  .remelle-quick-sheet__options {
    margin-top: 22px;
  }

  .remelle-quick-sheet__legend {
    margin: 0 0 10px;
    color: #670d0d;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-quick-sheet__choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .remelle-quick-sheet__choice {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid rgba(103, 13, 13, 0.28);
    background: #faf5f0;
    color: #670d0d;
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .remelle-quick-sheet__choice.is-selected {
    border-color: #670d0d;
    background: #670d0d;
    color: #faf5f0;
  }

  .remelle-quick-sheet__choice.is-unavailable {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .remelle-quick-sheet__error {
    margin: 12px 0 0;
    color: #670d0d;
    font-size: 12px;
    line-height: 1.35;
  }

  .remelle-quick-sheet__error[hidden] {
    display: none;
  }

  .remelle-quick-sheet__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    margin-top: 20px;
    padding: 0 20px;
    border: 1px solid #670d0d;
    background: #670d0d;
    color: #faf5f0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.96px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .remelle-quick-sheet__add:disabled,
  .remelle-quick-sheet__add[aria-busy='true'] {
    opacity: 0.55;
    cursor: wait;
  }

  .remelle-quick-sheet__add:focus-visible,
  .remelle-quick-sheet__close:focus-visible,
  .remelle-quick-sheet__choice:focus-visible {
    outline: 1px solid #670d0d;
    outline-offset: 3px;
  }

  /* Mobile bottom sheet */
  .remelle-quick-sheet--sheet {
    align-items: flex-end;
    padding: 0;
  }

  .remelle-quick-sheet--sheet .remelle-quick-sheet__panel {
    width: min(440px, 100%);
    max-height: min(88vh, 720px);
    padding: 12px 20px calc(20px + env(safe-area-inset-bottom, 0px));
    border-radius: 18px 18px 0 0;
    box-shadow: 0 -18px 48px rgba(6, 5, 5, 0.18);
    transform: translateY(100%);
    transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .remelle-quick-sheet--sheet.is-visible .remelle-quick-sheet__panel {
    transform: translateY(0);
  }

  .remelle-quick-sheet--sheet .remelle-quick-sheet__handle {
    display: block;
  }

  /* Desktop centered modal */
  .remelle-quick-sheet--modal {
    align-items: center;
    padding: 32px 24px;
  }

  .remelle-quick-sheet--modal .remelle-quick-sheet__panel {
    width: min(420px, calc(100% - 48px));
    max-height: min(82vh, 640px);
    padding: 28px 28px 24px;
    border-radius: 4px;
    box-shadow: 0 24px 64px rgba(6, 5, 5, 0.22);
    transform: translateY(12px) scale(0.96);
    opacity: 0;
    transition:
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.28s ease;
  }

  .remelle-quick-sheet--modal.is-visible .remelle-quick-sheet__panel {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .remelle-quick-sheet--modal .remelle-quick-sheet__handle {
    display: none;
  }

  .remelle-quick-sheet--modal .remelle-quick-sheet__product {
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 18px;
  }

  .remelle-quick-sheet--modal .remelle-quick-sheet__image {
    width: 110px;
    height: 146px;
  }

  .remelle-quick-sheet--modal .remelle-quick-sheet__name {
    font-size: 26px;
  }

  .remelle-cart__line {
    transition: opacity 0.22s ease, transform 0.22s ease, max-height 0.28s ease, margin 0.28s ease, padding 0.28s ease;
  }

  .remelle-cart__line.is-removing {
    opacity: 0;
    transform: translateX(12px);
    pointer-events: none;
  }

  .remelle-cart.is-pending .remelle-cart__qty-btn,
  .remelle-cart.is-pending .remelle-cart__qty-input {
    cursor: wait;
  }

  @media (prefers-reduced-motion: reduce) {
    .remelle-quick-sheet,
    .remelle-quick-sheet__panel,
    .remelle-cart__line {
      transition: none;
    }
  }
{% endstylesheet %}
