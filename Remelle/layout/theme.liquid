<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {{ 'instrument-sans.woff2' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {{ 'instrument-serif.woff2' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {{ 'snell-roundhand-regular.ttf' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% render 'chrome-styles' %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
    <script src="{{ 'remelle-cart.js' | asset_url }}" defer></script>
  </head>

  <body>
    <a class="skip-to-content visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
