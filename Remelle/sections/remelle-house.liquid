<section
  class="remelle-house"
  {% if section.settings.heading != blank or section.settings.script != blank %}
    aria-labelledby="RemelleHouseTitle-{{ section.id }}"
  {% endif %}
>
  <div class="remelle-house__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="remelle-house__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.script != blank -%}
      <h2 class="remelle-house__heading" id="RemelleHouseTitle-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          <span class="remelle-house__serif">{{ section.settings.heading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.script != blank -%}
          <span class="remelle-house__script">{{ section.settings.script | escape }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="remelle-house__body">{{ section.settings.description | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .remelle-house {
    background: var(--color-beige);
    color: var(--color-burgundy);
    padding: 80px var(--page-inset);
    text-align: center;
  }

  .remelle-house__inner {
    width: min(720px, 100%);
    margin-inline: auto;
  }

  .remelle-house__eyebrow {
    margin: 0 0 24px;
    color: var(--color-burgundy);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 1.44px;
    text-transform: uppercase;
  }

  .remelle-house__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    color: var(--color-burgundy);
  }

  .remelle-house__serif {
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 400;
    line-height: 56px;
    letter-spacing: -0.02em;
  }

  .remelle-house__script {
    font-family: var(--font-script);
    font-size: 56px;
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -1.4px;
  }

  .remelle-house__body {
    width: min(544px, 100%);
    margin: 16px auto 0;
    color: var(--color-black);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 22px;
    letter-spacing: 0;
  }

  @media (max-width: 720px) {
    .remelle-house {
      padding-block: 56px;
    }

    .remelle-house__serif,
    .remelle-house__script {
      font-size: clamp(36px, 8vw, 56px);
    }

    .remelle-house__serif {
      line-height: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.house",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "01 — The brand"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Luxury, redefined through"
    },
    {
      "type": "text",
      "id": "script",
      "label": "t:labels.script",
      "default": "Intention & authenticity"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Beyond fleeting trends, Remelle creates timeless statement pieces with meticulous craftsmanship and an unwavering commitment to quality. Each collection is made to be seen and remembered."
    }
  ],
  "presets": [
    {
      "name": "t:general.house"
    }
  ]
}
{% endschema %}
